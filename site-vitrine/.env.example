# PostHog — analytics produit (clés exposées côté client, préfixe PUBLIC_ requis par Astro)
# Clé de projet PostHog (Project Settings > Project API Key, commence par "phc_")
PUBLIC_POSTHOG_KEY=
# Hôte d'ingestion : https://eu.i.posthog.com (UE) ou https://us.i.posthog.com (US)
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
