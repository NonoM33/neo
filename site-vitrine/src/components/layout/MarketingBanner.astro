---
import { SITE_CONFIG } from '../../config/site';
const apiBase = SITE_CONFIG.apiBaseUrl;
---

<div id="neo-marketing-banner" style="display:none"></div>

<script is:inline define:vars={{ apiBase }}>
  (async () => {
    const host = document.getElementById('neo-marketing-banner');
    if (!host) return;
    try {
      const res = await fetch(`${apiBase}/api/public/marketing/banner`);
      if (!res.ok) return;
      const { banner } = await res.json();
      if (!banner) return;

      const dismissedKey = `neo-banner-dismissed-${banner.id}`;
      if (banner.dismissible && localStorage.getItem(dismissedKey)) return;

      host.style.cssText = [
        'display:flex',
        'align-items:center',
        'justify-content:center',
        'gap:12px',
        'padding:10px 16px',
        'font-size:0.95rem',
        'font-weight:500',
        'text-align:center',
        'position:relative',
        'z-index:50',
        `background:${banner.bgColor}`,
        `color:${banner.textColor}`,
      ].join(';');

      const message = document.createElement('span');
      message.textContent = banner.message;
      host.appendChild(message);

      if (banner.linkUrl) {
        const link = document.createElement('a');
        link.href = banner.linkUrl;
        link.textContent = banner.linkLabel || 'En savoir plus';
        link.style.cssText = `color:${banner.textColor};font-weight:700;text-decoration:underline`;
        host.appendChild(link);
      }

      if (banner.dismissible) {
        const close = document.createElement('button');
        close.setAttribute('aria-label', 'Fermer');
        close.innerHTML = '&times;';
        close.style.cssText = [
          'position:absolute',
          'right:12px',
          'top:50%',
          'transform:translateY(-50%)',
          'background:none',
          'border:none',
          'cursor:pointer',
          'font-size:1.3rem',
          'line-height:1',
          `color:${banner.textColor}`,
        ].join(';');
        close.addEventListener('click', () => {
          host.remove();
          localStorage.setItem(dismissedKey, '1');
        });
        host.appendChild(close);
      }
    } catch {
      /* silencieux : la bannière est non bloquante */
    }
  })();
</script>
