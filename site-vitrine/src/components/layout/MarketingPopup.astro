---
import { SITE_CONFIG } from '../../config/site';
const apiBase = SITE_CONFIG.apiBaseUrl;
---

<div id="neo-marketing-popup"></div>

<script is:inline define:vars={{ apiBase }}>
  (async () => {
    const host = document.getElementById('neo-marketing-popup');
    if (!host) return;

    // Respecte la fréquence d'affichage par visiteur.
    function alreadyShown(popup) {
      const key = `neo-popup-${popup.id}`;
      if (popup.frequency === 'toujours') return false;
      if (popup.frequency === 'une_fois_session') return sessionStorage.getItem(key) === '1';
      if (popup.frequency === 'une_fois_jour') {
        const last = localStorage.getItem(key);
        return last ? Date.now() - Number(last) < 86_400_000 : false;
      }
      return false;
    }

    function markShown(popup) {
      const key = `neo-popup-${popup.id}`;
      if (popup.frequency === 'une_fois_session') sessionStorage.setItem(key, '1');
      else if (popup.frequency === 'une_fois_jour') localStorage.setItem(key, String(Date.now()));
    }

    function escapeHtml(s) {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    function render(popup) {
      const overlay = document.createElement('div');
      overlay.style.cssText =
        'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px';

      const card = document.createElement('div');
      card.style.cssText =
        'background:#fff;color:#1a1a1a;border-radius:16px;max-width:460px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);position:relative';

      let html = '';
      const close =
        '<button aria-label="Fermer" data-close style="position:absolute;right:12px;top:12px;background:rgba(0,0,0,0.4);color:#fff;border:none;border-radius:50%;width:30px;height:30px;cursor:pointer;font-size:1.1rem;line-height:1;z-index:2">&times;</button>';

      if (popup.imageUrl) {
        html += `<img src="${escapeHtml(popup.imageUrl)}" alt="" style="width:100%;height:180px;object-fit:cover;display:block" />`;
      }
      html += '<div style="padding:24px">';
      html += `<h3 style="margin:0 0 12px;font-size:1.5rem;font-weight:700">${escapeHtml(popup.title)}</h3>`;
      // Le corps autorise du HTML riche saisi côté admin.
      html += `<div style="font-size:1rem;line-height:1.5;color:#444">${popup.body}</div>`;

      if (popup.promoCode) {
        html += `<div style="margin-top:16px;padding:12px;border:2px dashed #0d6efd;border-radius:10px;text-align:center;font-weight:700;font-size:1.1rem;letter-spacing:1px;color:#0d6efd">${escapeHtml(popup.promoCode)}</div>`;
      }
      if (popup.ctaLabel && popup.ctaUrl) {
        html += `<a href="${escapeHtml(popup.ctaUrl)}" style="display:block;margin-top:18px;padding:12px 20px;background:#0d6efd;color:#fff;border-radius:10px;text-align:center;font-weight:600;text-decoration:none">${escapeHtml(popup.ctaLabel)}</a>`;
      }
      html += '</div>';

      card.innerHTML = close + html;
      overlay.appendChild(card);
      host.appendChild(overlay);
      markShown(popup);

      const dismiss = () => overlay.remove();
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || e.target.hasAttribute('data-close')) dismiss();
      });
    }

    try {
      const res = await fetch(`${apiBase}/api/public/marketing/popup`);
      if (!res.ok) return;
      const { popup } = await res.json();
      if (!popup || alreadyShown(popup)) return;
      setTimeout(() => render(popup), (popup.delaySeconds || 0) * 1000);
    } catch {
      /* silencieux : la pop-up est non bloquante */
    }
  })();
</script>
