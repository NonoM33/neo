---
import { SITE_CONFIG } from '../config/site';

const siteUrl = SITE_CONFIG.url;
const title = 'Configurez votre maison connectée — Neo Domotique';
const description =
  "Composez votre installation domotique pièce par pièce, voyez le prix en temps réel et recevez votre devis. Alarme, caméras, capteurs : simple et assisté.";

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Configurateur maison connectée - Neo Domotique',
  description,
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={`${siteUrl}/configurateur`} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:type" content="website" />
<meta property="og:url" content={`${siteUrl}/configurateur`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="fr_FR" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/neo/styles-v2.css" />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script defer data-domain={SITE_CONFIG.plausibleDomain} src="https://plausible.io/js/script.js"></script>
<style is:global>
  .cfg-panel { display: none; }
  .cfg-panel.active { display: block; animation: cfgIn .35s ease; }
  @keyframes cfgIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .cfg-field { margin-bottom: 18px; }
  .cfg-field label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .cfg-field input, .cfg-field textarea { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: #fff; font-family: inherit; font-size: 15px; }
  .cfg-choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: 10px; }
  .cfg-choice { padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.03); cursor: pointer; transition: all .15s; text-align: center; }
  .cfg-choice:hover { border-color: rgba(110,168,254,.5); }
  .cfg-choice.sel { border-color: #6ea8fe; background: rgba(110,168,254,.12); }
  .cfg-choice .t { font-weight: 600; font-size: 15px; }
  .cfg-choice .s { font-size: 13px; color: #8a8f98; margin-top: 3px; }
  .cfg-choices--inline { grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
  .cfg-choices--inline .cfg-choice { padding: 10px 12px; }

  /* ── Étape 2 : maison par pièces ── */
  .cfg-room-intro { text-align: center; color: #8a8f98; font-size: 14px; margin: 0 0 22px; }
  /* Barre de recherche produit (étape 2) */
  .cfg-search { position: relative; display: flex; align-items: center; margin-bottom: 14px; }
  .cfg-search__ic { position: absolute; left: 14px; width: 18px; height: 18px; color: #8a8f98; pointer-events: none; }
  .cfg-search__input { width: 100%; box-sizing: border-box; padding: 13px 14px 13px 42px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: #f3f6fb; font-size: 15px; font-family: inherit; transition: border-color .15s, background .15s, box-shadow .15s; }
  .cfg-search__input::placeholder { color: #8a8f98; }
  .cfg-search__input:focus { outline: none; border-color: rgba(110,168,254,.7); background: rgba(110,168,254,.06); box-shadow: 0 0 0 3px rgba(110,168,254,.18); }
  /* Panneau produits inline (remplace l'ancienne modale) */
  .cfg-roominline { margin-top: 18px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 16px; }
  .cfg-roominline__head { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .cfg-roominline__title { font-size: 19px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
  .cfg-roominline__total { margin-left: auto; text-align: right; display: flex; flex-direction: column; }
  .cfg-roominline__total span { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: #8a8f98; }
  .cfg-roominline__total b { font-size: 17px; color: #cfe0ff; }
  .cfg-catlabel { font-size: 12px; text-transform: uppercase; letter-spacing: .6px; color: #8a8f98; margin: 22px 0 12px; display: flex; align-items: center; gap: 7px; }
  .cfg-catlabel-ic { width: 16px; height: 16px; }
  .cfg-cattabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 4px 0 18px; }
  .cfg-cattab { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 12.5px; font-weight: 600; color: #aab4c4; cursor: pointer; padding: 6px 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.03); transition: color .15s, border-color .15s, background .15s; }
  .cfg-cattab:hover { color: #fff; border-color: rgba(255,255,255,.22); }
  .cfg-cattab.active { color: #fff; border-color: color-mix(in srgb, var(--accent,#6ea8fe) 70%, transparent); background: color-mix(in srgb, var(--accent,#6ea8fe) 16%, transparent); }
  .cfg-cattab__ic { display: inline-flex; color: var(--accent,#6ea8fe); }
  .cfg-cattab__ic svg { width: 15px; height: 15px; }
  .cfg-cattab__n { font-size: 11px; font-weight: 700; color: #8a8f98; background: rgba(255,255,255,.06); border-radius: 999px; padding: 1px 7px; }
  .cfg-cattab.active .cfg-cattab__n { color: #0b0d12; background: var(--accent,#6ea8fe); }
  .cfg-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px,1fr)); gap: 14px; }
  .cfg-card { position: relative; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: rgba(255,255,255,.025); display: flex; flex-direction: column; overflow: hidden; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .cfg-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.22); box-shadow: 0 18px 40px -18px rgba(0,0,0,.75); }
  .cfg-card.sel { border-color: transparent; box-shadow: 0 0 0 1.5px var(--accent,#6ea8fe), 0 18px 44px -16px color-mix(in srgb, var(--accent,#6ea8fe) 50%, transparent); }
  .cfg-card__cover { position: relative; aspect-ratio: 16 / 10; display: grid; place-items: center; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,.06);
    background:
      radial-gradient(120% 130% at 28% 16%, color-mix(in srgb, var(--accent,#6ea8fe) 34%, transparent), transparent 62%),
      linear-gradient(160deg, rgba(255,255,255,.06), rgba(255,255,255,0)); }
  .cfg-card__cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cfg-card__icon { width: 48px; height: 48px; color: var(--accent,#cfe0ff); filter: drop-shadow(0 6px 18px color-mix(in srgb, var(--accent,#6ea8fe) 55%, transparent)); transition: transform .2s ease; }
  .cfg-card:hover .cfg-card__icon { transform: scale(1.09) rotate(-3deg); }
  .cfg-card__brand { position: absolute; top: 10px; left: 10px; font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .7px; color: #eef2f8; padding: 4px 9px; border-radius: 999px; background: rgba(10,12,18,.5); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.14); }
  .cfg-card__check { position: absolute; top: 9px; right: 9px; width: 24px; height: 24px; border-radius: 50%; display: none; align-items: center; justify-content: center; background: linear-gradient(135deg,#6ea8fe,#a98eff); color: #0b0d12; box-shadow: 0 4px 12px rgba(110,168,254,.5); }
  .cfg-card.sel .cfg-card__check { display: flex; }
  .cfg-card__check svg { width: 13px; height: 13px; }
  .cfg-card__body { padding: 13px 14px 2px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .cfg-card__name { font-weight: 600; font-size: 14.5px; line-height: 1.3; }
  .cfg-card__desc { font-size: 12px; color: #8a8f98; line-height: 1.35; }
  .cfg-card__price { margin-top: 6px; font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .cfg-card__price .ttc { font-size: 11px; font-weight: 500; color: #8a8f98; margin-left: 4px; }
  .cfg-card__foot { padding: 10px 14px 14px; }
  .cfg-add { width: 100%; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.05); color: #fff; border-radius: 11px; padding: 10px; font-size: 13.5px; font-weight: 600; font-family: inherit; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px; transition: border-color .15s, background .15s; }
  .cfg-add svg { width: 15px; height: 15px; }
  .cfg-add:hover { border-color: var(--accent,#6ea8fe); background: color-mix(in srgb, var(--accent,#6ea8fe) 15%, transparent); }
  .cfg-stepper { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.12); border-radius: 11px; padding: 4px; }
  .cfg-stepper button { width: 38px; height: 34px; border-radius: 8px; border: none; background: rgba(255,255,255,.06); color: #fff; font-size: 19px; cursor: pointer; line-height: 1; transition: background .15s; }
  .cfg-stepper button:hover { background: color-mix(in srgb, var(--accent,#6ea8fe) 32%, transparent); }
  .cfg-stepper .qty { flex: 1; text-align: center; font-variant-numeric: tabular-nums; font-weight: 700; font-size: 15px; }
  .cfg-add--done { border-color: color-mix(in srgb, var(--ok,#46d98a) 55%, transparent); background: color-mix(in srgb, var(--ok,#46d98a) 14%, transparent); color: #d7ffe9; }
  .cfg-add--done svg { color: var(--ok,#46d98a); }
  .cfg-add__n { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: color-mix(in srgb, var(--ok,#46d98a) 28%, transparent); font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }

  /* « Dans cette pièce » : sélection compacte d'un coup d'œil (icône, nom, prix
     unitaire, stepper, total ligne) + sous-total. */
  .cfg-roomsel { display: flex; flex-direction: column; gap: 8px; margin: 4px 0 6px; }
  .cfg-selrow { display: grid; grid-template-columns: 34px minmax(0,1fr) auto auto; align-items: center; gap: 12px; padding: 9px 12px; border: 1px solid rgba(255,255,255,.1); border-radius: 12px; background: rgba(255,255,255,.03); }
  .cfg-selrow__ic { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: color-mix(in srgb, var(--accent,#6ea8fe) 18%, transparent); color: var(--accent,#6ea8fe); }
  .cfg-selrow__svg { width: 19px; height: 19px; }
  .cfg-selrow__txt { min-width: 0; }
  .cfg-selrow__name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cfg-selrow__meta { font-size: 12px; color: #8a8f98; margin-top: 2px; }
  .cfg-selrow__qty { padding: 3px; gap: 4px; }
  .cfg-selrow__qty button { width: 30px; height: 28px; font-size: 17px; }
  .cfg-selrow__qty .qty { min-width: 22px; flex: 0 0 auto; font-size: 14px; }
  .cfg-selrow__total { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 14.5px; min-width: 78px; text-align: right; }
  .cfg-roomsel__foot { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px 2px; font-size: 13px; color: #cfe0ff; }
  .cfg-roomsel__foot b { font-size: 16px; font-variant-numeric: tabular-nums; color: #fff; }

  .cfg-recap-room { font-size: 13px; text-transform: uppercase; letter-spacing: .6px; color: #cfe0ff; margin: 18px 0 6px; }
  .cfg-recap-room:first-child { margin-top: 0; }
  .cfg-recap-line { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.06); font-size: 15px; }
  .cfg-recap-line .auto { font-size: 12px; color: #a98eff; margin-left: 6px; }
  .cfg-recap-empty { color: #8a8f98; padding: 24px 0; text-align: center; }
  .cfg-error { color: #ff8a8a; font-size: 14px; margin-top: 10px; min-height: 18px; }
  .cfg-hp { position: absolute; left: -9999px; opacity: 0; height: 0; }
  .cfg-done { text-align: center; padding: 40px 0; }
  .cfg-done .ic { font-size: 56px; }
  .cfg-loading { text-align: center; color: #8a8f98; padding: 40px 0; }
  .cfg-modal { position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(6px); z-index: 50; display: grid; place-items: center; padding: 20px; }
  .cfg-modal-card { background: #14171e; border: 1px solid rgba(255,255,255,.12); border-radius: 18px; padding: 28px; max-width: 380px; width: 100%; text-align: center; position: relative; }
  .cfg-modal-x { position: absolute; top: 12px; right: 16px; background: none; border: none; color: #8a8f98; font-size: 26px; cursor: pointer; line-height: 1; }
  .cfg-qr { background: #fff; border-radius: 12px; padding: 12px; width: 200px; height: 200px; margin: 0 auto 18px; }
  .cfg-qr svg { width: 100%; height: 100%; display: block; }
  .cfg-code { font-family: 'JetBrains Mono', monospace; font-size: 22px; font-weight: 600; letter-spacing: 2px; margin-bottom: 16px; color: #cfe0ff; }
  .cfg-linkrow { display: flex; gap: 8px; }
  .cfg-linkrow input { flex: 1; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: #fff; font-size: 13px; }
  /* ── Builder 3D ── */
  .cfg-stage { width: 100%; height: min(46vh, 380px); min-height: 260px; border-radius: 20px; overflow: hidden; background: radial-gradient(120% 120% at 50% 0%, rgba(110,168,254,.12), rgba(11,13,18,0) 60%), #0b0d12; border: 1px solid rgba(255,255,255,.08); touch-action: none; cursor: grab; }
  .cfg-stage:active { cursor: grabbing; }
  .cfg-stage canvas { display: block; width: 100% !important; height: 100% !important; }
  .cfg-stage-hint { text-align: center; color: #8a8f98; font-size: 13px; margin: 12px 0 0; }
  .cfg-stage-hint b { color: #cfe0ff; font-weight: 700; }
  .cfg-stage-wrap { position: relative; }
  .cfg-floors { position: absolute; top: 12px; right: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; }
  .cfg-floorbtn { appearance: none; cursor: pointer; font: inherit; font-size: 12.5px; font-weight: 600; color: #cfe0ff; background: rgba(13,16,22,.72); border: 1px solid rgba(255,255,255,.12); border-radius: 999px; padding: 6px 12px; backdrop-filter: blur(8px); transition: all .15s; white-space: nowrap; }
  .cfg-floorbtn:hover { border-color: rgba(110,168,254,.55); color: #fff; }
  .cfg-floorbtn.active { background: rgba(110,168,254,.2); border-color: #6ea8fe; color: #fff; }
  .cfg-floorbtn i { font-style: normal; opacity: .7; }
  .cfg-addroom__floors { display: flex; flex-wrap: wrap; gap: 6px; }
  /* Barre « Mes pièces » */
  .cfg-rooms-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 12px; }
  .cfg-rooms-label { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #8a8f98; font-weight: 700; margin-right: 2px; }
  .cfg-roomchip { display: inline-flex; align-items: center; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent) 45%, rgba(255,255,255,.1)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 16%, rgba(255,255,255,.03)), rgba(255,255,255,.02)); overflow: hidden; }
  .cfg-roomchip.active { border-color: color-mix(in srgb, var(--accent) 85%, #fff); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 40%, transparent); }
  .cfg-roomchip__open { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px 7px 12px; background: none; border: none; color: #e4ebff; font-size: 13px; font-weight: 600; cursor: pointer; }
  .cfg-roomchip__open b { color: color-mix(in srgb, var(--accent) 80%, #fff); }
  .cfg-roomchip__emoji { font-size: 15px; }
  .cfg-roomchip__floor { font-style: normal; font-size: 10.5px; font-weight: 700; letter-spacing: .3px; text-transform: uppercase; color: color-mix(in srgb, var(--accent) 75%, #fff); background: color-mix(in srgb, var(--accent) 20%, rgba(255,255,255,.04)); padding: 1px 6px; border-radius: 999px; }
  .cfg-roomchip__x { padding: 0 10px; align-self: stretch; background: none; border: none; border-left: 1px solid rgba(255,255,255,.1); color: #9aa1ad; font-size: 16px; cursor: pointer; transition: color .15s, background .15s; }
  .cfg-roomchip__x:hover { color: #ff8a8a; background: rgba(255,122,122,.12); }
  .cfg-roomadd { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; border: 1px dashed rgba(255,255,255,.28); background: rgba(255,255,255,.03); color: #cfe0ff; font-size: 13px; font-weight: 700; cursor: pointer; transition: border-color .15s, background .15s, transform .12s; }
  .cfg-roomadd:hover { border-color: #6ea8fe; background: rgba(110,168,254,.12); transform: translateY(-1px); }
  /* Modale d'ajout de pièce */
  .cfg-addroom { position: fixed; inset: 0; z-index: 210; display: grid; place-items: center; padding: 20px; background: rgba(4,6,10,.6); backdrop-filter: blur(6px); opacity: 0; pointer-events: none; transition: opacity .2s ease; }
  .cfg-addroom.open { opacity: 1; pointer-events: auto; }
  .cfg-addroom__sheet { width: 100%; max-width: 460px; border-radius: 20px; border: 1px solid rgba(255,255,255,.12); background: #0e1118; padding: 20px; box-shadow: 0 24px 60px rgba(0,0,0,.6); transform: translateY(10px) scale(.98); transition: transform .22s ease; }
  .cfg-addroom.open .cfg-addroom__sheet { transform: translateY(0) scale(1); }
  .cfg-addroom__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .cfg-addroom__head h3 { margin: 0; font-size: 18px; color: #eef3ff; }
  .cfg-addroom__x { width: 36px; height: 36px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.05); color: #cfd6e4; font-size: 18px; cursor: pointer; }
  .cfg-addroom__x:hover { background: rgba(255,255,255,.1); color: #fff; }
  .cfg-addroom__sub { margin: 14px 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #8a8f98; font-weight: 700; }
  .cfg-addroom__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; }
  .cfg-addroom-opt { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--accent) 40%, rgba(255,255,255,.1)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 14%, rgba(255,255,255,.03)), rgba(255,255,255,.02)); color: #e4ebff; font-size: 13px; font-weight: 600; cursor: pointer; transition: transform .12s, border-color .15s; }
  .cfg-addroom-opt:hover { border-color: color-mix(in srgb, var(--accent) 70%, transparent); transform: translateY(-1px); }
  .cfg-addroom-opt__emoji { font-size: 16px; }
  .cfg-addroom__form { display: flex; gap: 8px; }
  .cfg-addroom__input { flex: 1; padding: 11px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); color: #eef3ff; font-size: 14px; }
  .cfg-addroom__input:focus { outline: none; border-color: #6ea8fe; }
  .cfg-addroom__add { flex: none; padding: 11px 16px; border-radius: 12px; border: none; background: linear-gradient(135deg, #6ea8fe, #a98eff); color: #0b0d12; font-size: 14px; font-weight: 800; cursor: pointer; }
  .cfg-addroom__add:hover { filter: brightness(1.05); }
  /* Guide IA — chat embarqué à côté du configurateur */
  .cfg-ai { display: flex; flex-direction: column; height: min(78vh, 660px); min-height: 480px; border-radius: 20px; border: 1px solid rgba(110,168,254,.28); background: #11151d; box-shadow: 0 24px 70px rgba(0,0,0,.45), 0 0 0 1px rgba(110,168,254,.08); overflow: hidden; }
  .cfg-ai__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 14px 16px; background: linear-gradient(135deg, rgba(110,168,254,.18), rgba(169,142,255,.14)); border-bottom: 1px solid rgba(255,255,255,.08); }
  .cfg-ai__id { display: flex; align-items: center; gap: 10px; }
  .cfg-ai__avatar { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; background: rgba(0,0,0,.25); }
  .cfg-ai__id b { display: block; font-size: 14px; color: #eef3ff; }
  .cfg-ai__sub { font-size: 12px; color: #9aa1ad; }
  .cfg-ai__x { width: 32px; height: 32px; border-radius: 9px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.05); color: #cfd6e4; font-size: 15px; cursor: pointer; flex: none; }
  .cfg-ai__x:hover { background: rgba(255,255,255,.1); color: #fff; }
  .cfg-ai__log { flex: 1; overflow-y: auto; padding: 14px 14px 6px; display: flex; flex-direction: column; gap: 10px; -webkit-overflow-scrolling: touch; }
  .cfg-ai__msg { max-width: 86%; padding: 10px 13px; border-radius: 14px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
  .cfg-ai__msg.bot { align-self: flex-start; background: rgba(255,255,255,.06); color: #e4ebff; border-bottom-left-radius: 4px; }
  .cfg-ai__msg.user { align-self: flex-end; background: linear-gradient(135deg, #6ea8fe, #a98eff); color: #0b0d12; font-weight: 600; border-bottom-right-radius: 4px; }
  .cfg-ai__msg.act { align-self: stretch; max-width: 100%; background: rgba(95,224,176,.1); border: 1px solid rgba(95,224,176,.4); color: #c7ffe6; font-size: 13px; }
  .cfg-ai__msg.typing { color: #9aa1ad; font-style: italic; }
  .cfg-ai__msg.bot strong { font-weight: 700; color: #fff; }
  .cfg-ai__msg.bot em { font-style: italic; color: #eef3ff; }
  .cfg-ai__msg.bot code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; padding: 1px 5px; border-radius: 6px; background: rgba(110,168,254,.16); color: #cfe0ff; }
  .cfg-ai__suggest { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 8px; }
  .cfg-ai__chip { padding: 7px 11px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); color: #cfe0ff; font-size: 12px; font-weight: 600; cursor: pointer; transition: border-color .15s, background .15s; }
  .cfg-ai__chip:hover { border-color: #6ea8fe; background: rgba(110,168,254,.12); }
  /* Boutons cliquables contextuels sous un message (façon bot Telegram) */
  .cfg-ai__choices { align-self: flex-start; max-width: 86%; display: flex; flex-wrap: wrap; gap: 7px; margin: -2px 0 2px; }
  .cfg-ai__choice { padding: 8px 13px; border-radius: 12px; border: 1px solid rgba(110,168,254,.45); background: linear-gradient(135deg, rgba(110,168,254,.16), rgba(169,142,255,.12)); color: #dce8ff; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; text-align: left; transition: border-color .15s, background .15s, transform .12s; }
  .cfg-ai__choice:hover { border-color: #6ea8fe; background: linear-gradient(135deg, rgba(110,168,254,.28), rgba(169,142,255,.22)); transform: translateY(-1px); }
  .cfg-ai__choice:active { transform: translateY(0); }
  .cfg-ai__form { display: flex; gap: 8px; padding: 12px 14px; border-top: 1px solid rgba(255,255,255,.08); }
  .cfg-ai__input { flex: 1; padding: 11px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); color: #eef3ff; font-size: 14px; }
  .cfg-ai__input:focus { outline: none; border-color: #6ea8fe; }
  .cfg-ai__send { flex: none; width: 44px; border-radius: 12px; border: none; background: linear-gradient(135deg, #6ea8fe, #a98eff); color: #0b0d12; font-size: 16px; font-weight: 800; cursor: pointer; }
  .cfg-ai__send:disabled { opacity: .5; cursor: default; }

  /* ============================================================
     CLAUDE DESIGN — App shell « planner » (dense, plein écran)
     ============================================================ */
  .cfg-app {
    --neo: #5b8cff; --neo-2: #86a9ff; --neo-press: #4a73e6; --neo-soft: rgba(91,140,255,.14);
    --ink: #eef2f8; --ink-2: #a7b1c2; --ink-3: #6f7a90; --ink-4: #4a5468;
    --line: rgba(255,255,255,.08); --line-2: rgba(255,255,255,.14);
    --glass: rgba(255,255,255,.04); --glass-2: rgba(255,255,255,.07);
    --panel: #0e1320; --bg-2: #0b0f1a; --ok: #46d98a;
    --topbar: 58px; --pricebar: 66px; --chat-w: 340px;
    position: fixed; inset: 0; z-index: 1;
    display: flex; flex-direction: column;
    height: 100vh; height: 100dvh; overflow: hidden;
    font-family: 'Geist', system-ui, -apple-system, sans-serif; font-size: 14px; color: var(--ink);
    background:
      radial-gradient(120% 80% at 80% -10%, rgba(91,140,255,.10), transparent 55%),
      radial-gradient(90% 70% at 0% 110%, rgba(255,178,89,.06), transparent 55%),
      #070a12;
  }

  /* ── Topbar + wizard ── */
  .cfg-topbar { flex: none; height: var(--topbar); display: flex; align-items: center; gap: 18px; padding: 0 18px; border-bottom: 1px solid var(--line); background: rgba(11,15,26,.6); }
  .cfg-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .cfg-brand__logo { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: linear-gradient(145deg,#5b8cff,#3a5bd0); box-shadow: 0 4px 14px -4px rgba(91,140,255,.7); }
  .cfg-brand__logo .dot { width: 9px; height: 9px; border-radius: 50%; background: #fff; }
  .cfg-brand b { font-size: 15px; font-weight: 600; letter-spacing: -.01em; }
  .cfg-wsteps { display: flex; align-items: center; gap: 8px; margin: 0 auto; }
  .cfg-wstep { display: flex; align-items: center; gap: 9px; }
  .cfg-wstep .wn { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; font-family: 'JetBrains Mono', monospace; background: var(--glass-2); color: var(--ink-3); border: 1px solid var(--line-2); transition: background .2s, color .2s, border-color .2s, box-shadow .2s; }
  .cfg-wstep .wl { font-size: 13px; font-weight: 600; color: var(--ink-3); transition: color .2s; }
  .cfg-wstep.active .wn { background: var(--neo); color: #fff; border-color: var(--neo); box-shadow: 0 0 0 4px var(--neo-soft); }
  .cfg-wstep.active .wl { color: var(--ink); }
  .cfg-wstep.done .wn { background: var(--ok); border-color: var(--ok); color: #06140d; }
  .cfg-wstep.done .wl { color: var(--ink-2); }
  .cfg-wbar { width: 30px; height: 2px; border-radius: 2px; background: var(--line-2); transition: background .2s; }
  .cfg-wbar.done { background: var(--ok); }
  .cfg-top-r { display: flex; align-items: center; gap: 12px; }
  .cfg-ticon { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--line); background: var(--glass); display: grid; place-items: center; color: var(--ink-2); cursor: pointer; transition: background .15s, color .15s, opacity .15s; }
  .cfg-ticon:hover:not(:disabled) { background: var(--glass-2); color: var(--ink); }
  .cfg-ticon:disabled { opacity: .35; cursor: default; }
  .cfg-top-link { font-size: 13px; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .cfg-top-link:hover { color: var(--ink); }
  .cfg-top-total { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
  .cfg-top-total .l { font-size: 10px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
  .cfg-top-total .v { font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cfg-top-x { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--line); background: var(--glass); display: grid; place-items: center; color: var(--ink-2); text-decoration: none; font-size: 15px; }
  .cfg-top-x:hover { background: var(--glass-2); color: var(--ink); }

  /* ── Body : 3 zones ── */
  .cfg-body { flex: 1; display: flex; min-height: 0; overflow: hidden; }
  .cfg-form { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
  .cfg-panel { display: none; }
  .cfg-panel.active { display: flex; animation: cfgIn .3s var(--ease, ease); }
  .cfg-panel--zones.active { flex: 1; min-height: 0; flex-direction: column; }
  .cfg-panel--zones .cfg-loading { margin: auto; }
  .cfg-zones { flex: 1; min-height: 0; display: grid; grid-template-columns: 1.04fr 1fr; }
  .cfg-zone { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow-y: auto; border-right: 1px solid var(--line); padding: 14px 16px 18px; }
  .cfg-zone--house { background: radial-gradient(80% 70% at 50% 30%, rgba(91,140,255,.07), transparent 70%); }
  .cfg-zone--prod { background: var(--bg-2); }
  .cfg-zone--chat { width: var(--chat-w); flex: none; border-left: 1px solid var(--line); border-right: none; background: var(--panel); overflow: hidden; padding: 0; }
  .cfg-zone__head { flex: none; display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .cfg-zone__head h2 { font-size: 14px; font-weight: 600; margin: 0; }
  .cfg-zone--house .cfg-stage { height: min(38vh, 340px); min-height: 220px; }
  .cfg-zone--house .cfg-rooms-bar { margin-top: 14px; }
  .cfg-zone--chat .cfg-ai { height: 100%; min-height: 0; border: none; border-radius: 0; box-shadow: none; }
  .cfg-roominline { margin-top: 0; border-top: 0; padding-top: 0; }

  /* ── Pack essentiel (pièce vide) ── */
  .cfg-emptypack { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0 0 14px; padding: 14px 16px; border-radius: 13px; border: 1px solid var(--line-2); background: linear-gradient(135deg, rgba(91,140,255,.12), rgba(177,140,255,.08)); }
  .cfg-emptypack__l { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .cfg-emptypack__ic { width: 38px; height: 38px; border-radius: 11px; flex: none; display: grid; place-items: center; font-size: 18px; background: var(--neo); box-shadow: 0 4px 14px -4px rgba(91,140,255,.7); }
  .cfg-emptypack b { font-size: 14px; font-weight: 600; }
  .cfg-emptypack p { font-size: 12px; color: var(--ink-3); margin-top: 1px; }
  .cfg-emptypack__btn { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; border: none; background: var(--neo); color: #fff; font: inherit; font-size: 13.5px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: background .15s, transform .12s; }
  .cfg-emptypack__btn:hover { background: var(--neo-press); transform: translateY(-1px); }
  @media (max-width: 1024px) { .cfg-emptypack__btn { margin-left: 0; } }

  /* ── Étapes 2/3/done : carte centrée scrollable ── */
  .cfg-panel--center.active { flex: 1; min-height: 0; overflow-y: auto; justify-content: center; align-items: flex-start; padding: 36px 22px 28px; }
  .cfg-centercard { width: 100%; max-width: 640px; margin: 0 auto; }
  .cfg-centercard__title { font-size: 22px; font-weight: 600; margin: 0 0 18px; }

  /* ── Pricebar ── */
  .cfg-pricebar { position: static; flex: none; min-height: var(--pricebar); display: flex; align-items: center; gap: 16px; padding: 10px 18px; border-top: 1px solid var(--line); background: rgba(11,15,26,.9); flex-wrap: wrap; }
  .cfg-pb-summary { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .cfg-pb-stat { display: flex; flex-direction: column; line-height: 1.15; }
  .cfg-pb-stat .l { font-size: 10px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; font-weight: 600; }
  .cfg-pb-stat .v { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cfg-pb-total .l { color: var(--neo-2); }
  .cfg-pb-total .v { font-size: 22px; letter-spacing: -.01em; }
  .cfg-pb-sep { width: 1px; height: 30px; background: var(--line); }
  .cfg-bridge-note { display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: 99px; border: 1px solid rgba(70,217,138,.3); background: rgba(70,217,138,.1); color: var(--ok); font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; transition: background .15s; }
  .cfg-bridge-note[hidden] { display: none; }
  .cfg-bridge-note:hover { background: rgba(70,217,138,.18); }
  .cfg-pb-actions { margin-left: auto; display: flex; gap: 10px; }
  .cfg-btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 11px; border: 1px solid transparent; font: inherit; font-size: 14px; font-weight: 600; color: #fff; background: var(--neo); cursor: pointer; white-space: nowrap; transition: background .15s, transform .12s; }
  .cfg-btn:hover { background: var(--neo-press); }
  .cfg-btn.ghost { background: var(--glass); border-color: var(--line-2); color: var(--ink); }
  .cfg-btn.ghost:hover { background: var(--glass-2); }
  .cfg-btn.lg { padding: 12px 22px; font-size: 15px; }
  .cfg-btn:disabled { opacity: .5; cursor: default; }

  /* ── Responsive : iPad paysage garde 3 colonnes, portrait empile ── */
  @media (max-width: 1080px) { .cfg-wstep .wl { display: none; } }
  @media (max-width: 920px) {
    .cfg-app { position: static; inset: auto; height: auto; min-height: 100vh; overflow: visible; }
    .cfg-body { flex-direction: column; overflow: visible; }
    .cfg-form { overflow: visible; }
    .cfg-zones { grid-template-columns: 1fr; }
    .cfg-zone { overflow: visible; border-right: none; border-bottom: 1px solid var(--line); }
    .cfg-zone--prod { order: 1; }
    .cfg-zone--house { order: 2; }
    .cfg-zone--chat { width: auto; border-left: none; border-top: 1px solid var(--line); }
    .cfg-zone--chat .cfg-ai { height: min(68vh, 540px); }
    .cfg-panel--center.active { min-height: 60vh; }
    .cfg-pricebar { position: sticky; bottom: 0; z-index: 30; }
    .cfg-top-link { display: none; }
  }
</style>
</head>
<body>

<div class="cfg-app" data-api={SITE_CONFIG.apiBaseUrl}>
  <!-- ───────── TOPBAR + WIZARD ───────── -->
  <header class="cfg-topbar">
    <a class="cfg-brand" href="/">
      <span class="cfg-brand__logo" aria-hidden="true"><span class="dot"></span></span>
      <b>Neo</b>
    </a>
    <nav class="cfg-wsteps" aria-label="Étapes du configurateur">
      <div class="cfg-wstep" data-step="1"><span class="wn">1</span><span class="wl">Pièces</span></div>
      <span class="cfg-wbar" data-bar="1"></span>
      <div class="cfg-wstep" data-step="2"><span class="wn">2</span><span class="wl">Estimation</span></div>
      <span class="cfg-wbar" data-bar="2"></span>
      <div class="cfg-wstep" data-step="3"><span class="wn">3</span><span class="wl">Coordonnées</span></div>
    </nav>
    <div class="cfg-top-r">
      <button type="button" class="cfg-ticon" id="cfg-undo" title="Annuler" aria-label="Annuler" disabled>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
      </button>
      <button type="button" class="cfg-ticon" id="cfg-redo" title="Rétablir" aria-label="Rétablir" disabled>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"/></svg>
      </button>
      <a class="cfg-top-link" href={SITE_CONFIG.phoneHref}>{SITE_CONFIG.phone}</a>
      <div class="cfg-top-total"><span class="l">Total</span><span class="v" id="cfg-total-top">—</span></div>
      <a class="cfg-top-x" href="/" aria-label="Quitter le configurateur" title="Retour au site">✕</a>
    </div>
  </header>

  <!-- ───────── BODY : 3 zones (maison · produits · Léo) ───────── -->
  <div class="cfg-body">
   <form id="cfg-form" class="cfg-form" novalidate>
      <!-- ÉTAPE 1 — Pièces (planner 3 zones) -->
      <section class="cfg-panel cfg-panel--zones" data-panel="1">
        <div id="cfg-catalog" class="cfg-loading">Chargement du catalogue…</div>
        <div id="cfg-builder" class="cfg-zones" hidden>
          <!-- ZONE 1 — Maison 3D -->
          <section class="cfg-zone cfg-zone--house">
            <div class="cfg-zone__head"><h2>Votre maison</h2></div>
            <div class="cfg-stage-wrap">
              <div id="cfg-stage" class="cfg-stage"></div>
              <div id="cfg-floors" class="cfg-floors" aria-label="Étages"></div>
            </div>
            <p class="cfg-stage-hint">🖱️ Tournez la maison · <b>cliquez une pièce</b> pour voir et ajouter ses équipements 👉</p>
            <div id="cfg-rooms-bar" class="cfg-rooms-bar"></div>
          </section>
          <!-- ZONE 2 — Produits -->
          <section class="cfg-zone cfg-zone--prod">
            <div class="cfg-search">
              <svg class="cfg-search__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
              <input id="cfg-search" class="cfg-search__input" type="search" autocomplete="off" placeholder="Rechercher un produit, une marque…" />
            </div>
            <div id="cfg-roominline" class="cfg-roominline"></div>
          </section>
        </div>
        <!-- Modale d'ajout de pièce -->
        <div id="cfg-addroom" class="cfg-addroom" hidden aria-hidden="true">
          <div class="cfg-addroom__sheet" role="dialog" aria-modal="true" aria-label="Ajouter une pièce">
            <div class="cfg-addroom__head">
              <h3>Ajouter une pièce</h3>
              <button type="button" id="cfg-addroom-close" class="cfg-addroom__x" aria-label="Fermer">✕</button>
            </div>
            <p class="cfg-addroom__sub">À quel étage&nbsp;?</p>
            <div id="cfg-addroom-floors" class="cfg-addroom__floors"></div>
            <p class="cfg-addroom__sub">Cochez une pièce courante…</p>
            <div id="cfg-addroom-grid" class="cfg-addroom__grid"></div>
            <p class="cfg-addroom__sub">…ou créez la vôtre :</p>
            <div id="cfg-addroom-form" class="cfg-addroom__form">
              <input id="cfg-addroom-name" class="cfg-addroom__input" type="text" placeholder="ex : Buanderie, Bureau…" maxlength="40" autocomplete="off" />
              <button type="button" id="cfg-addroom-add" class="cfg-addroom__add">＋ Créer</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ÉTAPE 2 — Estimation -->
      <section class="cfg-panel cfg-panel--center" data-panel="2">
        <div class="cfg-centercard">
          <h2 class="cfg-centercard__title">Votre estimation</h2>
          <div class="cfg-field">
            <label>Qui installe&nbsp;?</label>
            <div class="cfg-choices cfg-choices--inline" data-radio="installMode">
              <div class="cfg-choice sel" data-value="pro"><div class="t">Un pro Neo</div><div class="s">Installation clé en main</div></div>
              <div class="cfg-choice" data-value="autonome"><div class="t">Moi-même</div><div class="s">Livré avec notice de pose</div></div>
            </div>
          </div>
          <div id="cfg-recap"></div>
          <p class="lead" style="font-size:14px;margin-top:16px;color:#8a8f98">
            Estimation indicative TTC. Le devis final est confirmé par un conseiller.
          </p>
        </div>
      </section>

      <!-- ÉTAPE 3 — Coordonnées -->
      <section class="cfg-panel cfg-panel--center" data-panel="3">
       <div class="cfg-centercard">
        <div class="cfg-field"><label for="cfg-firstName">Prénom</label><input id="cfg-firstName" name="firstName" /></div>
        <div class="cfg-field"><label for="cfg-lastName">Nom</label><input id="cfg-lastName" name="lastName" /></div>
        <div class="cfg-field"><label for="cfg-email">Email</label><input id="cfg-email" name="email" type="email" /></div>
        <div class="cfg-field"><label for="cfg-phone">Téléphone</label><input id="cfg-phone" name="phone" type="tel" /></div>
        <div class="cfg-field"><label for="cfg-postalCode">Code postal</label><input id="cfg-postalCode" name="postalCode" /></div>
        <div class="cfg-field"><label for="cfg-city">Ville (optionnel)</label><input id="cfg-city" name="city" /></div>
        <div class="cfg-field"><label for="cfg-message">Message (optionnel)</label><textarea id="cfg-message" name="message" rows="3"></textarea></div>
        <label class="cfg-field" style="display:flex;gap:10px;align-items:flex-start;font-weight:400;font-size:14px">
          <input type="checkbox" name="consent" style="width:auto;margin-top:3px" />
          <span>J'accepte que mes données soient utilisées pour me recontacter au sujet de ma demande.</span>
        </label>
        <input class="cfg-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
       </div>
      </section>

      <!-- SUCCÈS -->
      <section class="cfg-panel cfg-panel--center" data-panel="done">
        <div class="cfg-done">
          <div class="ic">✅</div>
          <h2 class="scene-title">Configuration envoyée&nbsp;!</h2>
          <p class="lead" id="cfg-done-msg">Votre configuration a bien été enregistrée. Un conseiller vous recontacte sous 24h.</p>
          <a class="btn" href="/">Retour à l'accueil</a>
        </div>
      </section>

      <div class="cfg-error" id="cfg-error"></div>
    </form>

    <!-- ZONE 3 — Léo (toujours visible) -->
    <aside class="cfg-zone cfg-zone--chat">
      <div id="cfg-ai" class="cfg-ai">
        <div class="cfg-ai__head">
          <div class="cfg-ai__id">
            <span class="cfg-ai__avatar" aria-hidden="true">🤖</span>
            <div>
              <b>Léo, votre guide domotique</b>
              <span class="cfg-ai__sub">Conseils, budget &amp; dépendances</span>
            </div>
          </div>
        </div>
        <div id="cfg-ai-log" class="cfg-ai__log" aria-live="polite"></div>
        <div class="cfg-ai__suggest" id="cfg-ai-suggest"></div>
        <form id="cfg-ai-form" class="cfg-ai__form">
          <input id="cfg-ai-input" class="cfg-ai__input" type="text" autocomplete="off"
            placeholder="Ex : j'ai 800 € pour sécuriser ma maison…" maxlength="500" />
          <button type="submit" id="cfg-ai-send" class="cfg-ai__send" aria-label="Envoyer">➤</button>
        </form>
      </div>
    </aside>
  </div>

  <!-- ───────── PRICEBAR ───────── -->
  <footer class="cfg-pricebar" id="cfg-pricebar">
    <div class="cfg-pb-summary">
      <div class="cfg-pb-stat"><span class="l">Pièces</span><span class="v" id="cfg-pb-rooms">0</span></div>
      <div class="cfg-pb-stat"><span class="l">Équipements</span><span class="v" id="cfg-count">0</span></div>
      <button type="button" class="cfg-bridge-note" id="cfg-bridge-note" title="En savoir plus sur la passerelle" hidden>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><path d="M12 20h.01"/></svg>
        1 passerelle incluse
      </button>
      <div class="cfg-pb-sep"></div>
      <div class="cfg-pb-stat cfg-pb-total"><span class="l">Total estimé TTC</span><span class="v" id="cfg-total">—</span></div>
    </div>
    <div class="cfg-pb-actions" id="cfg-nav">
      <button type="button" class="cfg-btn ghost" id="cfg-prev">Précédent</button>
      <button type="button" class="cfg-btn ghost" id="cfg-save">💾 Sauvegarder</button>
      <button type="button" class="cfg-btn lg" id="cfg-next">Estimation →</button>
    </div>
  </footer>
</div>

<!-- Modale code + QR -->
<div class="cfg-modal" id="cfg-modal" style="display:none">
  <div class="cfg-modal-card">
    <button type="button" class="cfg-modal-x" id="cfg-modal-close" aria-label="Fermer">×</button>
    <h3 style="margin:0 0 6px">Votre configuration est sauvegardée</h3>
    <p class="lead" style="font-size:14px;margin:0 0 18px;color:#8a8f98">
      Scannez le QR ou notez votre code pour la retrouver, ou donnez-le à votre conseiller.
    </p>
    <div class="cfg-qr" id="cfg-qr"></div>
    <div class="cfg-code" id="cfg-code">—</div>
    <div class="cfg-linkrow">
      <input type="text" id="cfg-link" readonly />
      <button type="button" class="btn" id="cfg-copy">Copier</button>
    </div>
  </div>
</div>

<script>
import { House3D } from '../configurateur/house3d';
import { addRoom, removeRoom, resolveActiveRooms, roomCategories, slugifyRoomKey } from '../configurateur/rooms';
import { filterProducts } from '../configurateur/search';
import { floorLabel, floorsOf } from '../configurateur/floors';
import { essentialPack } from '../configurateur/packs';
import { roomLines, roomSubtotal } from '../configurateur/room-summary';
import { createHistory, pushHistory, canUndo, canRedo, undo, redo, current as historyCurrent } from '../configurateur/history';
(function () {
  var main = document.querySelector('.cfg-app');
  var API = (main && main.getAttribute('data-api')) || '';
  var form = document.getElementById('cfg-form');
  var stepEls = Array.prototype.slice.call(document.querySelectorAll('.cfg-wstep'));
  var wbars = Array.prototype.slice.call(document.querySelectorAll('.cfg-wbar'));
  var panels = Array.prototype.slice.call(document.querySelectorAll('.cfg-panel'));
  var errorEl = document.getElementById('cfg-error');
  var navEl = document.getElementById('cfg-nav');
  var prevBtn = document.getElementById('cfg-prev');
  var nextBtn = document.getElementById('cfg-next');
  var priceBar = document.getElementById('cfg-pricebar');
  var totalEl = document.getElementById('cfg-total');
  var countEl = document.getElementById('cfg-count');

  var EUR = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
  var current = 1;
  // Le total s'affiche à deux endroits : la topbar et la pricebar.
  function setTotal(v) {
    var s = EUR.format(v || 0);
    if (totalEl) totalEl.textContent = s;
    var top = document.getElementById('cfg-total-top');
    if (top) top.textContent = s;
  }

  // Pièces de la maison → catégories pertinentes (mapping front).
  var ROOMS = [
    { key: 'salon',     label: 'Salon',           emoji: '🛋️', accent: '#6ea8fe', cats: ['Audio', 'Éclairage', 'Chauffage', 'Volets', 'Sécurité'] },
    { key: 'cuisine',   label: 'Cuisine',         emoji: '🍳', accent: '#ff9b6e', cats: ['Éclairage', 'Chauffage', 'Sécurité'] },
    { key: 'chambre',   label: 'Chambre',         emoji: '🛏️', accent: '#a98eff', cats: ['Éclairage', 'Chauffage', 'Volets', 'Audio'] },
    { key: 'entree',    label: 'Entrée',          emoji: '🚪', accent: '#5fe0b0', cats: ['Sécurité', 'Éclairage'] },
    { key: 'exterieur', label: 'Extérieur',       emoji: '🌳', accent: '#7bd88f', cats: ['Sécurité', 'Éclairage'] },
    { key: 'garage',    label: 'Garage',          emoji: '🚗', accent: '#cfa8ff', cats: ['Sécurité', 'Éclairage'] },
    { key: 'maison',    label: 'Toute la maison', emoji: '🏠', accent: '#6ee7ff', cats: ['Réseau', 'Services'] },
  ];
  var ROOM_BY_KEY = {};
  ROOMS.forEach(function (r) { ROOM_BY_KEY[r.key] = r; });
  // Barème de quantités du « Pack essentiel » : l'éclairage se pose en plusieurs
  // points, l'audio par paire, une serrure/caméra reste unitaire.
  var PACK_QTY_BY_CAT = { 'Éclairage': 3, 'Audio': 2, 'Volets': 2, 'Chauffage': 1, 'Sécurité': 1, 'Réseau': 1 };
  // Icônes vectorielles premium par catégorie (remplacent les emojis sur les cartes).
  var CAT_ICON = {
    'Audio': '<rect x="6.5" y="3" width="11" height="18" rx="3"/><circle cx="12" cy="14" r="3.3"/><circle cx="12" cy="6.8" r="1"/>',
    'Chauffage': '<path d="M14 14.8V5a2 2 0 1 0-4 0v9.8a4 4 0 1 0 4 0Z"/><path d="M12 14.6v-4.4"/>',
    'Réseau': '<path d="M4.6 12a10 10 0 0 1 14.8 0"/><path d="M8 15.2a5.5 5.5 0 0 1 8 0"/><circle cx="12" cy="18.4" r="1.1"/>',
    'Services': '<path d="M15 6.6a3.8 3.8 0 0 0-5.1 5L4.6 16.9a2 2 0 1 0 2.6 2.6l5.3-5.3a3.8 3.8 0 0 0 5-5.1l-2.4 2.4-2.1-.5-.5-2.1L15 6.6Z"/>',
    'Sécurité': '<path d="M12 3.2l7 3v5.1c0 4.4-3 7.6-7 8.7-4-1.1-7-4.3-7-8.7V6.2l7-3Z"/><path d="M9.2 12.2l1.9 1.9 3.7-4"/>',
    'Volets': '<rect x="4" y="4" width="16" height="16" rx="2.2"/><path d="M4 8.2h16M4 12h16M4 15.8h16"/>',
    'Éclairage': '<path d="M9.3 18.2h5.4"/><path d="M10.2 21h3.6"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2v.4h5.2v-.4c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
  };
  var CAT_ACCENT = {
    'Audio': '#6ea8fe', 'Chauffage': '#ff9b6e', 'Réseau': '#6ee7ff', 'Services': '#a98eff',
    'Sécurité': '#5fe0b0', 'Volets': '#cfa8ff', 'Éclairage': '#ffd66e',
  };
  var ICON_FALLBACK = '<rect x="4" y="7" width="16" height="13" rx="2"/><path d="M4 11h16M9 7V5h6v2"/>';
  var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>';
  var PLUS_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>';
  function catSvg(cat, cls) {
    return '<svg class="' + cls + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
      'stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
      (CAT_ICON[cat] || ICON_FALLBACK) + '</svg>';
  }
  function catAccent(cat) { return CAT_ACCENT[cat] || '#6ea8fe'; }

  // selection[roomKey][productId] = quantité.
  var selection = {};
  var lastEstimate = { lines: [], totalTTC: 0 };
  var PRODUCTS_BY_ID = {};      // id -> { name, priceTTC, category }
  var PRODUCTS_BY_CAT = {};     // category -> [{ id, name, priceTTC, category }]
  var catalogLoaded = false;
  var house3d = null;           // instance Three.js (lazy)
  var builderFailed = false;    // bascule grille 2D si WebGL KO
  var openRoomKey = null;       // pièce sélectionnée (produits affichés inline)
  var activeCat = null;         // onglet de catégorie actif dans le panneau produits
  var searchQuery = '';         // filtre de la barre de recherche produit
  var activeRoomKeys = null;    // pièces présentes dans la maison (lazy: toutes au départ)
  var customRooms = [];         // pièces sur-mesure ajoutées par le client
  var focusFloor = null;        // étage focalisé en 3D (null = vue d'ensemble)
  var pendingFloor = 0;         // étage choisi pour la prochaine pièce ajoutée

  function getQty(room, pid) { return (selection[room] && selection[room][pid]) || 0; }
  function setQty(room, pid, q) {
    if (!selection[room]) selection[room] = {};
    if (q <= 0) { delete selection[room][pid]; if (!Object.keys(selection[room]).length) delete selection[room]; }
    else selection[room][pid] = q;
  }
  function roomCount(room) {
    var s = selection[room]; if (!s) return 0;
    var n = 0; Object.keys(s).forEach(function (pid) { n += s[pid]; }); return n;
  }
  function totalCount() {
    var n = 0; Object.keys(selection).forEach(function (room) { n += roomCount(room); }); return n;
  }

  // ── Radios (choice chips) ──
  document.querySelectorAll('[data-radio]').forEach(function (group) {
    group.addEventListener('click', function (e) {
      var chip = e.target.closest('.cfg-choice');
      if (!chip) return;
      group.querySelectorAll('.cfg-choice').forEach(function (c) { c.classList.remove('sel'); });
      chip.classList.add('sel');
    });
  });
  function radioValue(name, fallback) {
    var sel = document.querySelector('[data-radio="' + name + '"] .cfg-choice.sel');
    return sel ? sel.getAttribute('data-value') : fallback;
  }

  // ── Catalogue ──
  function loadCatalog() {
    return fetch(API + '/api/public/configurateur/catalogue')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        storeCatalog(data.categories || []);
        catalogLoaded = true;
        renderRecap();
        if (current === 1) enterBuilder();
      })
      .catch(function () {
        document.getElementById('cfg-catalog').textContent =
          'Catalogue indisponible pour le moment. Réessayez plus tard.';
      });
  }

  function storeCatalog(categories) {
    PRODUCTS_BY_ID = {}; PRODUCTS_BY_CAT = {};
    categories.forEach(function (cat) {
      PRODUCTS_BY_CAT[cat.category] = (cat.products || []).map(function (p) {
        var item = {
          id: p.id, name: p.name, priceTTC: p.priceTTC, category: cat.category,
          brand: p.brand || '', description: p.description || '', imageUrl: p.imageUrl || '',
        };
        PRODUCTS_BY_ID[p.id] = item;
        return item;
      });
    });
  }

  function allCats() { return Object.keys(PRODUCTS_BY_CAT); }
  // Catégories proposées dans une pièce : tout le catalogue (favorites d'abord).
  function catsForRoom(room) { return roomCategories(allCats(), room); }
  // ── Pièces disponibles (≥ 1 produit) ──
  function roomHasProducts(room) {
    return catsForRoom(room).some(function (c) { return (PRODUCTS_BY_CAT[c] || []).length; });
  }
  function availableRooms() { return ROOMS.filter(roomHasProducts); }

  // Pièces actuellement dans la maison (prédéfinies actives + sur-mesure).
  function ensureActiveRooms() {
    // Tant que le catalogue n'est pas chargé, availableRooms() est vide :
    // resolveActiveRooms renvoie null pour NE PAS figer la maison à 0 pièce.
    activeRoomKeys = resolveActiveRooms(
      activeRoomKeys,
      availableRooms().map(function (r) { return r.key; }),
    );
  }
  function houseRooms() {
    ensureActiveRooms();
    return (activeRoomKeys || []).map(function (k) { return ROOM_BY_KEY[k]; }).filter(Boolean);
  }
  function activeKeySet() {
    ensureActiveRooms();
    var s = {}; (activeRoomKeys || []).forEach(function (k) { s[k] = true; }); return s;
  }

  // ── Builder 3D (étape 2) ──
  function enterBuilder() {
    if (!catalogLoaded) return;
    var loading = document.getElementById('cfg-catalog');
    var builder = document.getElementById('cfg-builder');
    loading.hidden = true;
    builder.hidden = false; // démasquer avant de construire pour que #cfg-stage ait une taille
    // Si la 3D échoue, on bascule en mode « plat » : on cache juste la scène,
    // mais la barre de pièces + le panneau produits restent pleinement utilisables.
    if (builderFailed || !initBuilder()) { enableFlatMode(); }
    else { house3d.setActive(true); }
    refreshBadges();
    // Sélectionne la première pièce par défaut pour que les produits soient
    // visibles immédiatement (sans clic), puis affiche le panneau inline.
    if (!openRoomKey) { var first = houseRooms()[0]; openRoomKey = first ? first.key : null; }
    renderRoomsBar();
    renderRoomInline();
    renderFloors();
    wireSearchInput();
    updateCount(); // rafraîchit le compteur de pièces (boot : maison vide)
    commitHistory(); // seed : état initial de la maison
  }

  // Mode plat (WebGL indisponible) : masque la scène 3D et son indice de
  // manipulation. La sélection de pièce se fait alors via la barre de puces.
  function enableFlatMode() {
    builderFailed = true;
    var stage = document.getElementById('cfg-stage');
    if (stage) stage.style.display = 'none';
    var hint = document.querySelector('.cfg-stage-hint');
    if (hint) hint.style.display = 'none';
  }

  // Branche la barre de recherche une seule fois (filtre live du catalogue).
  var searchWired = false;
  function wireSearchInput() {
    if (searchWired) return;
    var input = document.getElementById('cfg-search');
    if (!input) return;
    searchWired = true;
    input.addEventListener('input', function () {
      searchQuery = input.value;
      renderRoomInline();
    });
  }

  function initBuilder() {
    if (house3d) return true;
    if (builderFailed) return false;
    var stage = document.getElementById('cfg-stage');
    try {
      house3d = new House3D(stage, {
        rooms: houseRooms().map(function (r) { return { key: r.key, label: r.label, accent: r.accent, floor: r.floor || 0 }; }),
        onRoomClick: function (key) { openRoom(key); },
      });
      return true;
    } catch (err) {
      builderFailed = true;
      house3d = null;
      return false;
    }
  }

  function refreshBadges() {
    if (!house3d) return;
    houseRooms().forEach(function (r) { house3d.setRoomCount(r.key, roomCount(r.key)); });
  }

  // Reconstruit la scène 3D quand la liste des pièces change (dispose + recrée).
  function rebuildHouse() {
    if (!house3d) { renderRoomsBar(); renderRoomInline(); commitHistory(); return; }
    try { house3d.dispose(); } catch (_e) { /* noop */ }
    house3d = null;
    if (!initBuilder()) { enableFlatMode(); renderRoomsBar(); renderRoomInline(); renderFloors(); commitHistory(); return; }
    house3d.setActive(true);
    if (focusFloor != null) house3d.focusFloor(focusFloor);
    refreshBadges();
    renderRoomsBar();
    renderRoomInline();
    renderFloors();
    commitHistory();
  }

  // ── Historique annuler / rétablir ──
  // On capture un instantané sérialisable de tout l'état métier (sélection,
  // pièces actives, pièces sur-mesure, étages, pièce ouverte) pour pouvoir le
  // restaurer à l'identique. La pile est dédupliquée : un état inchangé n'est
  // jamais ré-empilé.
  var historyState = null;
  var applyingHistory = false;

  function snapshotState() {
    var floors = {};
    Object.keys(ROOM_BY_KEY).forEach(function (k) {
      if (ROOM_BY_KEY[k] && ROOM_BY_KEY[k].floor != null) floors[k] = ROOM_BY_KEY[k].floor;
    });
    return JSON.stringify({
      selection: selection,
      activeRoomKeys: activeRoomKeys,
      customRooms: customRooms,
      floors: floors,
      openRoomKey: openRoomKey,
      focusFloor: focusFloor,
      pendingFloor: pendingFloor,
    });
  }

  function restoreState(json) {
    var s;
    try { s = JSON.parse(json); } catch (_e) { return; }
    selection = s.selection || {};
    customRooms = s.customRooms || [];
    customRooms.forEach(function (r) { ROOM_BY_KEY[r.key] = r; });
    if (s.floors) Object.keys(s.floors).forEach(function (k) { if (ROOM_BY_KEY[k]) ROOM_BY_KEY[k].floor = s.floors[k]; });
    activeRoomKeys = s.activeRoomKeys || null;
    openRoomKey = s.openRoomKey || null;
    focusFloor = (s.focusFloor != null) ? s.focusFloor : null;
    pendingFloor = (s.pendingFloor != null) ? s.pendingFloor : 0;
  }

  function commitHistory() {
    if (applyingHistory) return;
    var snap = snapshotState();
    if (historyState == null) { historyState = createHistory(snap); updateUndoButtons(); return; }
    if (snap === historyCurrent(historyState)) return;
    historyState = pushHistory(historyState, snap, 50);
    updateUndoButtons();
  }

  function updateUndoButtons() {
    var u = document.getElementById('cfg-undo');
    var r = document.getElementById('cfg-redo');
    if (u) u.disabled = !(historyState && canUndo(historyState));
    if (r) r.disabled = !(historyState && canRedo(historyState));
  }

  function applyHistorySnapshot() {
    applyingHistory = true;
    restoreState(historyCurrent(historyState));
    rebuildHouse();
    refreshBadges();
    updateCount();
    runEstimate();
    updateUndoButtons();
    applyingHistory = false;
  }

  function doUndo() {
    if (!historyState || !canUndo(historyState)) return;
    historyState = undo(historyState);
    applyHistorySnapshot();
  }
  function doRedo() {
    if (!historyState || !canRedo(historyState)) return;
    historyState = redo(historyState);
    applyHistorySnapshot();
  }

  // ── Navigation par étage (sélecteur 3D) ──
  function houseFloors() {
    return floorsOf(houseRooms().map(function (r) { return { key: r.key, floor: r.floor || 0 }; }));
  }

  function setFocusFloor(floor) {
    focusFloor = floor;
    if (house3d) house3d.focusFloor(floor);
    renderFloors();
  }

  function renderFloors() {
    var host = document.getElementById('cfg-floors');
    if (!host) return;
    var floors = houseFloors();
    // Le sélecteur n'a de sens qu'à partir de 2 niveaux ; sinon on le masque.
    if (builderFailed || floors.length < 2) { host.hidden = true; host.innerHTML = ''; return; }
    host.hidden = false;
    var html = '<button type="button" class="cfg-floorbtn' + (focusFloor == null ? ' active' : '') + '" data-floor="all">🏠 Tout</button>';
    floors.forEach(function (f) {
      html += '<button type="button" class="cfg-floorbtn' + (focusFloor === f ? ' active' : '') + '" data-floor="' + f + '">' + esc(floorLabel(f)) + '</button>';
    });
    host.innerHTML = html;
    host.querySelectorAll('.cfg-floorbtn').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-floor');
        setFocusFloor(v === 'all' ? null : Number(v));
      });
    });
  }

  // ── Barre « Mes pièces » + ajout de pièce (sur-mesure ou prédéfinie) ──
  function renderRoomsBar() {
    var bar = document.getElementById('cfg-rooms-bar');
    if (!bar) return;
    bar.innerHTML = '';
    var label = document.createElement('span');
    label.className = 'cfg-rooms-label';
    label.textContent = 'Mes pièces';
    bar.appendChild(label);
    houseRooms().forEach(function (room) {
      var chip = document.createElement('span');
      chip.className = 'cfg-roomchip' + (room.key === openRoomKey ? ' active' : '');
      chip.style.setProperty('--accent', room.accent || '#6ea8fe');
      var n = roomCount(room.key);
      var floorTag = room.floor ? ' <i class="cfg-roomchip__floor">' + esc(floorLabel(room.floor)) + '</i>' : '';
      chip.innerHTML = '<button type="button" class="cfg-roomchip__open">' +
        '<span class="cfg-roomchip__emoji">' + (room.emoji || '🏠') + '</span>' +
        esc(room.label) + floorTag + (n > 0 ? ' <b>' + n + '</b>' : '') + '</button>' +
        '<button type="button" class="cfg-roomchip__x" aria-label="Retirer ' + esc(room.label) + '">&times;</button>';
      chip.querySelector('.cfg-roomchip__open').addEventListener('click', function () { openRoom(room.key); });
      chip.querySelector('.cfg-roomchip__x').addEventListener('click', function () { removeHouseRoom(room.key); });
      bar.appendChild(chip);
    });
    var add = document.createElement('button');
    add.type = 'button'; add.className = 'cfg-roomadd';
    add.innerHTML = '<span aria-hidden="true">＋</span> Ajouter une pièce';
    add.addEventListener('click', openAddRoom);
    bar.appendChild(add);
  }

  function removeHouseRoom(key) {
    ensureActiveRooms();
    activeRoomKeys = removeRoom(activeRoomKeys, key);
    if (selection[key]) { delete selection[key]; }
    scheduleEstimate();
    rebuildHouse();
  }

  function addPredefinedRoom(key) {
    ensureActiveRooms();
    if (ROOM_BY_KEY[key]) ROOM_BY_KEY[key].floor = pendingFloor;
    activeRoomKeys = addRoom(activeRoomKeys, key);
    if (pendingFloor != null) focusFloor = pendingFloor;
    rebuildHouse();
  }

  function addCustomRoom(name) {
    ensureActiveRooms();
    var clean = (name || '').trim();
    if (!clean) return;
    var existing = ROOMS.map(function (r) { return r.key; }).concat(customRooms.map(function (r) { return r.key; }));
    var key = slugifyRoomKey(clean, existing);
    var palette = ['#6ea8fe', '#ff9b6e', '#a98eff', '#5fe0b0', '#7bd88f', '#cfa8ff', '#6ee7ff', '#ffd66e'];
    var room = { key: key, label: clean, emoji: '🏠', accent: palette[customRooms.length % palette.length], cats: allCats(), floor: pendingFloor };
    customRooms.push(room);
    ROOM_BY_KEY[key] = room;
    activeRoomKeys = addRoom(activeRoomKeys, key);
    if (pendingFloor != null) focusFloor = pendingFloor;
    rebuildHouse();
  }

  // ── Mutations pilotées par Léo (l'IA contrôle les pièces et les étages) ──
  // L'IA fournit déjà une clé unique ; on crée la pièce sous cette clé exacte
  // pour que ses ajouts d'équipements (même tour) retombent sur la bonne pièce.
  function aiAddRoom(key, label, floor) {
    ensureActiveRooms();
    var clean = (label || '').trim();
    if (!key || !clean) return clean || key;
    var existing = ROOM_BY_KEY[key];
    if (existing) {
      existing.label = clean;
      if (floor != null) existing.floor = floor;
    } else {
      var palette = ['#6ea8fe', '#ff9b6e', '#a98eff', '#5fe0b0', '#7bd88f', '#cfa8ff', '#6ee7ff', '#ffd66e'];
      var room = { key: key, label: clean, emoji: '🏠', accent: palette[customRooms.length % palette.length], cats: allCats(), floor: floor || 0 };
      customRooms.push(room);
      ROOM_BY_KEY[key] = room;
    }
    activeRoomKeys = addRoom(activeRoomKeys, key);
    return clean;
  }

  function aiRenameRoom(key, label) {
    var room = ROOM_BY_KEY[key];
    var clean = (label || '').trim();
    if (!room || !clean) return null;
    room.label = clean;
    return clean;
  }

  function aiSetRoomFloor(key, floor) {
    var room = ROOM_BY_KEY[key];
    if (!room) return false;
    room.floor = floor || 0;
    return true;
  }

  // Choix de l'étage dans la modale : niveaux existants + un cran au-dessus et
  // un sous-sol, pour permettre d'étendre la maison vers le haut ou le bas.
  function renderAddRoomFloors() {
    var host = document.getElementById('cfg-addroom-floors');
    if (!host) return;
    var present = houseFloors();          // déjà triés du haut vers le bas
    var top = present.length ? present[0] : 0;
    var bottom = present.length ? present[present.length - 1] : 0;
    var options = present.slice();
    if (options.indexOf(top + 1) === -1) options.unshift(top + 1);   // nouvel étage
    if (options.indexOf(bottom - 1) === -1) options.push(bottom - 1); // nouveau sous-sol
    if (options.indexOf(pendingFloor) === -1) pendingFloor = present.indexOf(0) !== -1 ? 0 : (present[0] || 0);
    host.innerHTML = options.map(function (f) {
      var isNew = present.indexOf(f) === -1;
      return '<button type="button" class="cfg-floorbtn' + (f === pendingFloor ? ' active' : '') + '" data-floor="' + f + '">' +
        esc(floorLabel(f)) + (isNew ? ' <i>+</i>' : '') + '</button>';
    }).join('');
    host.querySelectorAll('.cfg-floorbtn').forEach(function (b) {
      b.addEventListener('click', function () { pendingFloor = Number(b.getAttribute('data-floor')); renderAddRoomFloors(); });
    });
  }

  function openAddRoom() {
    var modal = document.getElementById('cfg-addroom');
    var grid = document.getElementById('cfg-addroom-grid');
    var input = document.getElementById('cfg-addroom-name');
    grid.innerHTML = '';
    renderAddRoomFloors();
    var active = activeKeySet();
    availableRooms().forEach(function (room) {
      if (active[room.key]) return; // déjà dans la maison
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'cfg-addroom-opt';
      b.style.setProperty('--accent', room.accent);
      b.innerHTML = '<span class="cfg-addroom-opt__emoji">' + (room.emoji || '🏠') + '</span>' + esc(room.label);
      b.addEventListener('click', function () { addPredefinedRoom(room.key); closeAddRoom(); });
      grid.appendChild(b);
    });
    if (!grid.children.length) {
      var none = document.createElement('p');
      none.className = 'cfg-room-intro';
      none.textContent = 'Toutes les pièces prédéfinies sont déjà dans votre maison. Ajoutez-en une sur-mesure 👇';
      grid.appendChild(none);
    }
    if (input) input.value = '';
    modal.hidden = false;
    requestAnimationFrame(function () { modal.classList.add('open'); if (input) input.focus(); });
  }

  function closeAddRoom() {
    var modal = document.getElementById('cfg-addroom');
    if (!modal) return;
    modal.classList.remove('open');
    setTimeout(function () { if (!modal.classList.contains('open')) modal.hidden = true; }, 220);
  }

  // ── Produits inline (sans modale) ──
  // Sélectionner une pièce = afficher ses équipements dans le panneau de gauche,
  // sous la 3D, en permanence (à côté du chat). Aucune modale, rien ne masque.
  function allCatalogProducts() {
    return Object.keys(PRODUCTS_BY_ID).map(function (id) { return PRODUCTS_BY_ID[id]; });
  }

  function openRoom(roomKey) {
    if (!ROOM_BY_KEY[roomKey]) return;
    openRoomKey = roomKey;
    renderRoomsBar();      // met à jour la puce active
    renderRoomInline();
    var host = document.getElementById('cfg-roominline');
    if (host && typeof host.scrollIntoView === 'function') {
      host.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  // « Fermer » = effacer le filtre de recherche (la pièce reste sélectionnée).
  function closeRoom() {
    if (!searchQuery) return;
    searchQuery = '';
    var input = document.getElementById('cfg-search');
    if (input) input.value = '';
    renderRoomInline();
  }

  // Rendu du panneau produits : résultats de recherche (transversaux) si une
  // requête est saisie, sinon les équipements de la pièce sélectionnée groupés
  // par catégorie. L'ajout cible toujours la pièce courante.
  function renderRoomInline() {
    var host = document.getElementById('cfg-roominline');
    if (!host) return;
    if (!openRoomKey || !ROOM_BY_KEY[openRoomKey]) {
      var first = houseRooms()[0];
      openRoomKey = first ? first.key : null;
    }
    var room = openRoomKey ? ROOM_BY_KEY[openRoomKey] : null;
    host.innerHTML = '';

    var head = document.createElement('div');
    head.className = 'cfg-roominline__head';
    var title = document.createElement('div');
    title.className = 'cfg-roominline__title';
    if (searchQuery) {
      title.innerHTML = '<span aria-hidden="true">🔎</span><span>Résultats pour « ' + esc(searchQuery) + ' »' +
        (room ? ' → ' + esc(room.label) : '') + '</span>';
    } else if (room) {
      title.innerHTML = '<span aria-hidden="true">' + (room.emoji || '🏠') + '</span><span>' + esc(room.label) + '</span>';
    } else {
      title.innerHTML = '<span aria-hidden="true">🏠</span><span>Mes équipements</span>';
    }
    var lines = (!searchQuery && room) ? currentRoomLines() : [];
    var total = document.createElement('div');
    total.className = 'cfg-roominline__total';
    var totalLabel = (!searchQuery && room) ? 'Total pièce' : 'Total TTC';
    var totalValue = (!searchQuery && room)
      ? roomSubtotal(lines)
      : ((lastEstimate && lastEstimate.totalTTC) || 0);
    total.innerHTML = '<span>' + totalLabel + '</span><b id="cfg-panel-total">' +
      EUR.format(totalValue) + '</b>';
    head.appendChild(title); head.appendChild(total);
    host.appendChild(head);

    var body = document.createElement('div');
    body.className = 'cfg-roominline__body';

    if (searchQuery) {
      var matches = filterProducts(allCatalogProducts(), searchQuery);
      if (!matches.length) {
        body.innerHTML = '<p class="cfg-room-intro">Aucun équipement ne correspond à votre recherche.</p>';
      } else {
        var sgrid = document.createElement('div');
        sgrid.className = 'cfg-cards';
        matches.forEach(function (p) { sgrid.appendChild(productCard(p, openRoomKey)); });
        body.appendChild(sgrid);
      }
    } else if (room) {
      // Catégories disponibles (avec produits) pour la pièce courante.
      var availCats = catsForRoom(room).filter(function (c) {
        return (PRODUCTS_BY_CAT[c] || []).length > 0;
      });
      if (!availCats.length) {
        body.innerHTML = '<p class="cfg-room-intro">Aucun équipement pour cette pièce pour le moment.</p>';
      } else {
        // 1) Ce qui est DÉJÀ dans la pièce, d'un coup d'œil (toutes catégories,
        //    avec quantités et montants). Pièce vide → CTA Pack essentiel.
        if (lines.length === 0) {
          var pack = buildEssentialPack(room);
          if (pack.length) body.appendChild(emptyPackCta(room, pack));
        } else {
          body.appendChild(roomSelectionSection(lines));
        }
        // 2) Catalogue pour ajouter des équipements.
        var addLabel = document.createElement('div');
        addLabel.className = 'cfg-catlabel';
        addLabel.innerHTML = '<span>' + (lines.length ? 'Ajouter un équipement' : 'Choisir un équipement') + '</span>';
        body.appendChild(addLabel);
        if (availCats.indexOf(activeCat) === -1) activeCat = availCats[0];
        // Barre d'onglets de catégorie : on n'affiche qu'une catégorie à la fois.
        var tabs = document.createElement('div');
        tabs.className = 'cfg-cattabs';
        tabs.setAttribute('role', 'tablist');
        availCats.forEach(function (catName) {
          var n = (PRODUCTS_BY_CAT[catName] || []).length;
          var tab = document.createElement('button');
          tab.type = 'button';
          tab.className = 'cfg-cattab' + (catName === activeCat ? ' active' : '');
          tab.setAttribute('role', 'tab');
          tab.style.setProperty('--accent', catAccent(catName));
          tab.innerHTML = '<span class="cfg-cattab__ic">' + catSvg(catName, 'cfg-catlabel-ic') +
            '</span><span>' + esc(catName) + '</span><span class="cfg-cattab__n">' + n + '</span>';
          tab.addEventListener('click', function () { activeCat = catName; renderRoomInline(); });
          tabs.appendChild(tab);
        });
        body.appendChild(tabs);
        var grid = document.createElement('div');
        grid.className = 'cfg-cards';
        (PRODUCTS_BY_CAT[activeCat] || []).forEach(function (p) {
          grid.appendChild(productCard(p, openRoomKey));
        });
        body.appendChild(grid);
      }
    } else {
      body.innerHTML = '<p class="cfg-room-intro">Ajoutez une pièce pour commencer.</p>';
    }
    host.appendChild(body);
  }

  // Lignes d'équipements sélectionnés dans la pièce courante (pures, triées).
  function currentRoomLines() {
    return roomLines((openRoomKey && selection[openRoomKey]) || {}, PRODUCTS_BY_ID);
  }

  // Section « Dans cette pièce » : une ligne compacte par produit sélectionné
  // (icône, nom, prix unitaire, stepper, total ligne) + sous-total. Toute
  // modification de quantité re-rend le panneau pour garder la vue cohérente.
  function roomSelectionSection(lines) {
    var wrap = document.createElement('div');
    wrap.className = 'cfg-roomsel';
    lines.forEach(function (line) {
      var row = document.createElement('div');
      row.className = 'cfg-selrow';
      row.style.setProperty('--accent', catAccent(line.category));
      row.innerHTML =
        '<span class="cfg-selrow__ic">' + catSvg(line.category, 'cfg-selrow__svg') + '</span>' +
        '<div class="cfg-selrow__txt">' +
          '<div class="cfg-selrow__name">' + esc(line.name) + '</div>' +
          '<div class="cfg-selrow__meta">' +
            (line.brand ? esc(line.brand) + ' · ' : '') + EUR.format(line.unitTTC) + ' / u' +
          '</div>' +
        '</div>' +
        '<div class="cfg-stepper cfg-selrow__qty">' +
          '<button type="button" data-d="-1" aria-label="Retirer une unité">−</button>' +
          '<span class="qty">' + line.qty + '</span>' +
          '<button type="button" data-d="1" aria-label="Ajouter une unité">+</button>' +
        '</div>' +
        '<div class="cfg-selrow__total">' + EUR.format(line.lineTTC) + '</div>';
      row.querySelectorAll('.cfg-selrow__qty button').forEach(function (b) {
        b.addEventListener('click', function () {
          var n = Math.max(0, getQty(openRoomKey, line.id) + Number(b.getAttribute('data-d')));
          setQty(openRoomKey, line.id, n);
          renderRoomInline();
          scheduleEstimate();
        });
      });
      wrap.appendChild(row);
    });
    var foot = document.createElement('div');
    foot.className = 'cfg-roomsel__foot';
    foot.innerHTML = '<span>Sous-total pièce</span><b>' + EUR.format(roomSubtotal(lines)) + '</b>';
    wrap.appendChild(foot);
    return wrap;
  }

  // Pack essentiel : sélection de démarrage construite depuis le vrai catalogue
  // (catégories favorites de la pièce → premier produit facturable de chacune).
  function buildEssentialPack(room) {
    var favCats = roomCategories(allCats(), room);
    return essentialPack(favCats, PRODUCTS_BY_CAT, PACK_QTY_BY_CAT, 3);
  }

  function emptyPackCta(room, pack) {
    var box = document.createElement('div');
    box.className = 'cfg-emptypack';
    box.innerHTML =
      '<div class="cfg-emptypack__l">' +
        '<span class="cfg-emptypack__ic">✨</span>' +
        '<div><b>Cette pièce est vide</b><p>Démarrez en un clic, ajustez ensuite.</p></div>' +
      '</div>' +
      '<button type="button" class="cfg-emptypack__btn">+ Pack essentiel ' + esc(room.label) + '</button>';
    box.querySelector('.cfg-emptypack__btn').addEventListener('click', function () {
      applyPack(openRoomKey, pack);
    });
    return box;
  }

  function applyPack(roomKey, pack) {
    if (!roomKey || !pack || !pack.length) return;
    pack.forEach(function (item) {
      setQty(roomKey, item.id, getQty(roomKey, item.id) + item.qty);
    });
    renderRoomInline();
    renderRoomsBar();
    scheduleEstimate();
  }

  // Synchronise la pastille « Pack essentiel » sans re-render complet : on
  // ajoute/retire les cartes produit en place (renderFoot), donc on doit aussi
  // faire apparaître/disparaître le CTA selon que la pièce est vide ou non.
  function syncEmptyPackCta() {
    if (searchQuery) return;
    var host = document.getElementById('cfg-roominline');
    var body = host && host.querySelector('.cfg-roominline__body');
    if (!body) return;
    var existing = body.querySelector('.cfg-emptypack');
    var room = openRoomKey ? ROOM_BY_KEY[openRoomKey] : null;
    var shouldShow = !!room && roomCount(openRoomKey) === 0;
    if (shouldShow && !existing) {
      var pack = buildEssentialPack(room);
      if (pack.length) body.insertBefore(emptyPackCta(room, pack), body.firstChild);
    } else if (!shouldShow && existing) {
      existing.remove();
    }
  }

  function productCard(p, roomKey) {
    var card = document.createElement('div');
    card.className = 'cfg-card';
    card.style.setProperty('--accent', catAccent(p.category));

    var cover = p.imageUrl
      ? '<img src="' + esc(p.imageUrl) + '" alt="' + esc(p.name) + '" loading="lazy" />'
      : catSvg(p.category, 'cfg-card__icon');
    var brand = p.brand ? '<span class="cfg-card__brand">' + esc(p.brand) + '</span>' : '';
    var desc = p.description ? '<div class="cfg-card__desc">' + esc(p.description) + '</div>' : '';

    card.innerHTML =
      '<div class="cfg-card__cover">' + brand +
        '<span class="cfg-card__check">' + CHECK_SVG + '</span>' + cover +
      '</div>' +
      '<div class="cfg-card__body">' +
        '<div class="cfg-card__name">' + esc(p.name) + '</div>' + desc +
        '<div class="cfg-card__price">' + EUR.format(p.priceTTC) + '<span class="ttc">TTC</span></div>' +
      '</div>' +
      '<div class="cfg-card__foot"></div>';

    renderFoot(card.querySelector('.cfg-card__foot'), card, p, roomKey);
    return card;
  }

  // Pied de carte du catalogue : bouton « Ajouter » uniquement. La carte ne
  // gère plus de stepper — les quantités se règlent dans la liste « Dans cette
  // pièce » au-dessus, qui montre d'un coup d'œil ce qui est sélectionné. Une
  // carte déjà choisie affiche un état « Ajouté (N) » mais reste cliquable pour
  // en ajouter une unité. Après ajout on re-rend le panneau pour rafraîchir la
  // liste de sélection et son sous-total.
  function renderFoot(foot, card, p, roomKey) {
    var q = getQty(roomKey, p.id);
    card.classList.toggle('sel', q > 0);
    foot.innerHTML = q > 0
      ? '<button type="button" class="cfg-add cfg-add--done">' + CHECK_SVG +
          'Ajouté<span class="cfg-add__n">' + q + '</span></button>'
      : '<button type="button" class="cfg-add">' + PLUS_SVG + 'Ajouter</button>';
    foot.querySelector('.cfg-add').addEventListener('click', function () {
      setQty(roomKey, p.id, getQty(roomKey, p.id) + 1);
      renderRoomInline();
      scheduleEstimate();
    });
  }

  // ── Estimation live (débounce) ──
  var estTimer = null;
  function scheduleEstimate() {
    updateCount();
    refreshBadges();
    renderRoomsBar();
    syncEmptyPackCta();
    if (estTimer) clearTimeout(estTimer);
    estTimer = setTimeout(runEstimate, 400);
    commitHistory();
  }

  // Total affiché en tête du panneau pièce : sous-total de la pièce ouverte
  // (somme des lignes catalogue), ou total global TTC hors contexte pièce
  // (recherche, aucune pièce ouverte). La pricebar garde, elle, le total global.
  function updatePanelTotal() {
    var el = document.getElementById('cfg-panel-total');
    if (!el) return;
    var room = (!searchQuery && openRoomKey) ? ROOM_BY_KEY[openRoomKey] : null;
    el.textContent = EUR.format(room
      ? roomSubtotal(currentRoomLines())
      : ((lastEstimate && lastEstimate.totalTTC) || 0));
  }

  function selectionItems() {
    var out = [];
    Object.keys(selection).forEach(function (room) {
      Object.keys(selection[room]).forEach(function (pid) {
        var q = selection[room][pid];
        if (q > 0) out.push({ productId: pid, quantity: q, room: room });
      });
    });
    return out;
  }

  function updateCount() {
    var n = totalCount();
    if (countEl) countEl.textContent = String(n);
    var roomsEl = document.getElementById('cfg-pb-rooms');
    if (roomsEl) roomsEl.textContent = String(houseRooms().length);
    priceBar.style.display = current !== 'done' ? 'flex' : 'none';
    updateBridgeNote();
  }

  // Pastille « 1 passerelle incluse » : visible dès qu'une passerelle a été
  // ajoutée automatiquement par le moteur de prix (lignes `auto` de l'estimation).
  function updateBridgeNote() {
    var note = document.getElementById('cfg-bridge-note');
    if (!note) return;
    var autos = (lastEstimate && lastEstimate.lines || []).filter(function (l) { return l.auto; });
    note.hidden = autos.length === 0;
  }

  // ── Guide IA (chat) ──
  var aiHistory = [];      // [{role:'user'|'assistant', content}]
  var aiBusy = false;
  var aiGreeted = false;

  // Suggestions contextuelles : dépendent de l'étape et du panier réel.
  function aiSuggestionsForState() {
    var hasItems = selectionItems().length > 0;
    if (current === 1) {
      return hasItems
        ? ['Optimise mon panier', 'Que me manque-t-il ?', 'Explique les dépendances']
        : ['Sécurise mon entrée et mon salon', 'C’est quoi un bridge ?', 'Une caméra pas chère ?'];
    }
    if (current === 2) {
      return ['Comment réduire la facture ?', 'Pourquoi ce total ?', 'Une alternative moins chère ?'];
    }
    return ['Un conseiller peut-il me rappeler ?', 'Mes données sont-elles protégées ?'];
  }

  function aiLog() { return document.getElementById('cfg-ai-log'); }

  // Markdown minimal et sûr : on échappe d'abord, puis on applique le balisage.
  function aiMarkdown(text) {
    var html = String(text == null ? '' : text)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    html = html
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>')
      .replace(/(^|[^_])_([^_\n]+)_(?!_)/g, '$1<em>$2</em>');
    // Listes à puces : « - », « * » ou « • » en début de ligne → puce alignée.
    // (le gras/italique a déjà été converti, il ne reste donc plus de '*' de balisage)
    html = html.replace(/^[ \t]*[-•*]\s+/gm, '• ');
    return html;
  }

  function aiAppend(role, text, cls) {
    var log = aiLog(); if (!log) return null;
    var kind = cls || role;
    var el = document.createElement('div');
    el.className = 'cfg-ai__msg ' + kind;
    if (kind === 'bot') el.innerHTML = aiMarkdown(text);
    else el.textContent = text;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  // Boutons cliquables contextuels attachés au dernier message (façon clavier
  // inline d'un bot Telegram). Chaque choix porte un libellé (texte du bouton)
  // et le message envoyé au clic. On retire les choix précédents : ils ne valent
  // que pour le message en cours.
  function aiClearChoices() {
    var log = aiLog(); if (!log) return;
    log.querySelectorAll('.cfg-ai__choices').forEach(function (el) { el.remove(); });
  }

  function aiAppendChoices(choices) {
    if (!choices || !choices.length) return;
    var log = aiLog(); if (!log) return;
    aiClearChoices();
    var row = document.createElement('div');
    row.className = 'cfg-ai__choices';
    choices.slice(0, 4).forEach(function (c) {
      var label = c && typeof c.label === 'string' ? c.label.trim() : '';
      var send = c && typeof c.send === 'string' && c.send.trim() ? c.send.trim() : label;
      if (!label || !send) return;
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'cfg-ai__choice';
      b.textContent = label;
      b.addEventListener('click', function () { aiSubmit(send); });
      row.appendChild(b);
    });
    if (!row.childNodes.length) return;
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
  }

  function aiRenderSuggestions() {
    var host = document.getElementById('cfg-ai-suggest');
    if (!host) return;
    host.innerHTML = '';
    if (aiBusy) return;
    aiSuggestionsForState().forEach(function (s) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'cfg-ai__chip'; b.textContent = s;
      b.addEventListener('click', function () { aiSubmit(s); });
      host.appendChild(b);
    });
  }

  // Chat embarqué : on accueille une seule fois, au chargement de la page.
  function aiGreetOnce() {
    if (aiGreeted) return;
    aiGreeted = true;
    aiAppend('bot', 'Bonjour 👋 Je suis Léo, votre guide. Dites-moi votre projet ou votre budget, et je compose votre installation avec vous — j’explique tout (même les fameux bridges 😉).');
    aiRenderSuggestions();
  }

  function aiApplyActions(actions) {
    if (!actions || !actions.length) return;
    var summary = [];
    var roomsChanged = false;
    actions.forEach(function (a) {
      // Actions sur les pièces (Léo contrôle la maison, pas que le panier).
      if (a.type === 'add_room') {
        var addedLabel = aiAddRoom(a.room, a.label, a.floor);
        roomsChanged = true;
        summary.push('🏠 Pièce ajoutée · ' + addedLabel + (a.floor != null ? ' (' + floorLabel(a.floor) + ')' : ''));
        return;
      }
      if (a.type === 'rename_room') {
        var newLabel = aiRenameRoom(a.room, a.label);
        if (newLabel) { roomsChanged = true; summary.push('✏️ Pièce renommée · ' + newLabel); }
        return;
      }
      if (a.type === 'set_room_floor') {
        if (aiSetRoomFloor(a.room, a.floor)) {
          roomsChanged = true;
          var lbl = ROOM_BY_KEY[a.room] ? ROOM_BY_KEY[a.room].label : a.room;
          summary.push('🛗 ' + lbl + ' · ' + floorLabel(a.floor));
        }
        return;
      }
      if (a.type === 'remove_room') {
        var rmLabel = ROOM_BY_KEY[a.room] ? ROOM_BY_KEY[a.room].label : a.room;
        removeHouseRoom(a.room);
        roomsChanged = true;
        summary.push('🗑️ Pièce retirée · ' + rmLabel);
        return;
      }
      // Actions sur le panier.
      var p = PRODUCTS_BY_ID[a.productId];
      var name = p ? p.name : a.productId;
      var room = ROOM_BY_KEY[a.room] ? ROOM_BY_KEY[a.room].label : a.room;
      if (a.type === 'add') {
        setQty(a.room, a.productId, getQty(a.room, a.productId) + (a.quantity || 1));
        summary.push('＋ ' + (a.quantity || 1) + '× ' + name + ' · ' + room);
      } else if (a.type === 'remove') {
        if (a.quantity && a.quantity > 0) {
          setQty(a.room, a.productId, Math.max(0, getQty(a.room, a.productId) - a.quantity));
        } else {
          setQty(a.room, a.productId, 0);
        }
        summary.push('－ ' + name + ' · ' + room);
      }
    });
    if (roomsChanged) rebuildHouse();
    if (summary.length) {
      aiAppend('bot', summary.join('\n'), 'act');
      scheduleEstimate();
    }
  }

  function aiSubmit(text) {
    var clean = (text || '').trim();
    if (!clean || aiBusy) return;
    var input = document.getElementById('cfg-ai-input');
    if (input) input.value = '';
    aiClearChoices();
    aiAppend('user', clean);
    aiHistory.push({ role: 'user', content: clean });
    if (aiHistory.length > 16) aiHistory = aiHistory.slice(-16);
    aiBusy = true;
    aiRenderSuggestions();
    var sendBtn = document.getElementById('cfg-ai-send');
    if (sendBtn) sendBtn.disabled = true;
    var typing = aiAppend('bot', 'Léo réfléchit…', 'typing');
    var rooms = houseRooms().map(function (r) { return { key: r.key, label: r.label, floor: r.floor || 0 }; });
    fetch(API + '/api/public/configurateur/assistant', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: aiHistory, selection: selectionItems(), rooms: rooms }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (typing && typing.parentNode) typing.parentNode.removeChild(typing);
        var reply = (data && data.reply) || 'Désolé, je n’ai pas pu répondre. Réessayez ?';
        aiAppend('bot', reply);
        aiHistory.push({ role: 'assistant', content: reply });
        aiApplyActions(data && data.actions);
        aiAppendChoices(data && data.choices);
      })
      .catch(function () {
        if (typing && typing.parentNode) typing.parentNode.removeChild(typing);
        aiAppend('bot', 'Connexion interrompue. Un conseiller Neo peut aussi vous aider : réessayez dans un instant.');
      })
      .then(function () {
        aiBusy = false;
        if (sendBtn) sendBtn.disabled = false;
        aiRenderSuggestions();
      });
  }

  function runEstimate() {
    var items = selectionItems();
    if (!items.length) { lastEstimate = { lines: [], totalTTC: 0 }; setTotal(0); updatePanelTotal(); renderRecap(); updateBridgeNote(); return; }
    fetch(API + '/api/public/configurateur/estimer', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) { lastEstimate = data; setTotal(data.totalTTC || 0); updatePanelTotal(); renderRecap(); updateBridgeNote(); })
      .catch(function () {});
  }

  // ── Récap groupé par pièce + équipements requis ──
  function nameOf(pid) {
    if (PRODUCTS_BY_ID[pid]) return PRODUCTS_BY_ID[pid].name;
    var ln = findLine(pid); return ln ? ln.name : '';
  }
  function unitTTC(pid) {
    if (PRODUCTS_BY_ID[pid]) return PRODUCTS_BY_ID[pid].priceTTC;
    var ln = findLine(pid); return ln && ln.quantity ? ln.totalTTC / ln.quantity : 0;
  }
  function findLine(pid) {
    var lines = lastEstimate.lines || [];
    for (var i = 0; i < lines.length; i++) { if (lines[i].productId === pid) return lines[i]; }
    return null;
  }
  function recapLine(left, right) {
    return '<div class="cfg-recap-line"><span>' + left + '</span><span>' + right + '</span></div>';
  }

  function renderRecap() {
    var host = document.getElementById('cfg-recap');
    if (!selectionItems().length) {
      host.innerHTML = '<div class="cfg-recap-empty">Aucun équipement sélectionné. Revenez à l\'étape précédente pour composer votre installation.</div>';
      return;
    }
    var html = '';
    ROOMS.forEach(function (room) {
      var s = selection[room.key]; if (!s) return;
      var pids = Object.keys(s).filter(function (pid) { return s[pid] > 0; });
      if (!pids.length) return;
      html += '<div class="cfg-recap-room">' + room.emoji + ' ' + esc(room.label) + '</div>';
      pids.forEach(function (pid) {
        var q = s[pid];
        html += recapLine(q + '× ' + esc(nameOf(pid)), EUR.format(unitTTC(pid) * q));
      });
    });
    var autos = (lastEstimate.lines || []).filter(function (l) { return l.auto; });
    if (autos.length) {
      html += '<div class="cfg-recap-room">➕ Équipements requis</div>';
      autos.forEach(function (l) {
        html += recapLine(l.quantity + '× ' + esc(l.name) + '<span class="auto">requis</span>', EUR.format(l.totalTTC));
      });
    }
    html += '<div class="cfg-recap-line" style="border:none;font-weight:700;font-size:18px;margin-top:8px">' +
      '<span>Total TTC</span><span>' + EUR.format(lastEstimate.totalTTC || 0) + '</span></div>';
    host.innerHTML = html;
  }

  // ── Navigation ──
  function show(step) {
    current = step;
    panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-panel') === String(step)); });
    stepEls.forEach(function (el) {
      var n = Number(el.getAttribute('data-step'));
      el.classList.remove('active', 'done');
      if (step === 'done' || n < step) el.classList.add('done');
      else if (n === step) el.classList.add('active');
    });
    wbars.forEach(function (b) {
      var n = Number(b.getAttribute('data-bar'));
      b.classList.toggle('done', step === 'done' || n < step);
    });
    errorEl.textContent = '';
    if (step === 1) { if (catalogLoaded) enterBuilder(); }
    else { if (house3d) house3d.setActive(false); if (openRoomKey) closeRoom(); }
    var saveBtnEl = document.getElementById('cfg-save');
    if (step === 'done') {
      navEl.style.display = 'none';
      if (saveBtnEl) saveBtnEl.style.display = 'none';
      priceBar.style.display = 'none';
      return;
    }
    navEl.style.display = 'flex';
    prevBtn.style.display = step === 1 ? 'none' : 'inline-flex';
    if (saveBtnEl) saveBtnEl.style.display = 'inline-flex';
    nextBtn.textContent = step === 1 ? 'Estimation →' : (step === 2 ? 'Coordonnées →' : 'Envoyer ma demande');
    updateCount();
    aiRenderSuggestions();
  }

  function validate(step) {
    errorEl.textContent = '';
    if (step === 1) {
      if (!selectionItems().length) { errorEl.textContent = 'Sélectionnez au moins un équipement dans une pièce.'; return false; }
    }
    if (step === 3) {
      var req = ['firstName', 'lastName', 'email', 'phone', 'postalCode'];
      for (var i = 0; i < req.length; i++) {
        var f = form.elements[req[i]];
        if (!f || !f.value.trim()) { errorEl.textContent = 'Merci de compléter tous les champs obligatoires.'; return false; }
      }
      if (!/.+@.+\..+/.test(form.elements['email'].value)) { errorEl.textContent = 'Email invalide.'; return false; }
      if (!form.elements['consent'].checked) { errorEl.textContent = 'Vous devez accepter le traitement de vos données.'; return false; }
    }
    return true;
  }

  prevBtn.addEventListener('click', function () { if (current > 1) show(current - 1); });
  nextBtn.addEventListener('click', function () {
    if (!validate(current)) return;
    if (current < 3) { show(current + 1); return; }
    submit();
  });

  function val(n) { var f = form.elements[n]; return f && f.value.trim() ? f.value.trim() : undefined; }

  function submit() {
    nextBtn.disabled = true;
    var label = nextBtn.textContent;
    nextBtn.textContent = 'Envoi…';
    var body = {
      items: selectionItems(),
      installMode: radioValue('installMode', 'pro'),
      firstName: val('firstName'), lastName: val('lastName'),
      email: val('email'), phone: val('phone'),
      postalCode: val('postalCode'), city: val('city'),
      message: val('message'),
      consent: form.elements['consent'].checked,
      website: form.elements['website'].value || '',
    };
    fetch(API + '/api/public/configurateur/soumettre', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (res.ok && res.d.success) {
          if (res.d.message) document.getElementById('cfg-done-msg').textContent = res.d.message;
          show('done');
          if (window.plausible) window.plausible('Configurateur soumis');
        } else {
          errorEl.textContent = (res.d.error && res.d.error.message) || 'Une erreur est survenue. Réessayez.';
          nextBtn.disabled = false; nextBtn.textContent = label;
        }
      })
      .catch(function () {
        errorEl.textContent = 'Erreur réseau. Réessayez.';
        nextBtn.disabled = false; nextBtn.textContent = label;
      });
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  // ── Sauvegarde + code + QR ──
  var modal = document.getElementById('cfg-modal');
  var saveBtn = document.getElementById('cfg-save');
  document.getElementById('cfg-modal-close').addEventListener('click', function () { modal.style.display = 'none'; });
  modal.addEventListener('click', function (e) { if (e.target === modal) modal.style.display = 'none'; });
  // Échap ferme l'overlay pièce (ou la modale code)
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var addroom = document.getElementById('cfg-addroom');
    if (addroom && !addroom.hidden) { closeAddRoom(); return; }
    if (openRoomKey) { closeRoom(); return; }
    if (modal.style.display !== 'none') modal.style.display = 'none';
  });
  // Guide IA embarqué : accueil au chargement + envoi de message
  (function () {
    var aiForm = document.getElementById('cfg-ai-form');
    if (aiForm) aiForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = document.getElementById('cfg-ai-input');
      aiSubmit(input ? input.value : '');
    });
    var bridgeNote = document.getElementById('cfg-bridge-note');
    if (bridgeNote) bridgeNote.addEventListener('click', function () { aiSubmit('C’est quoi un bridge ?'); });
    var undoBtn = document.getElementById('cfg-undo');
    var redoBtn = document.getElementById('cfg-redo');
    if (undoBtn) undoBtn.addEventListener('click', doUndo);
    if (redoBtn) redoBtn.addEventListener('click', doRedo);
    // Raccourcis clavier (hors champ de saisie) : Ctrl/Cmd+Z, Ctrl/Cmd+Shift+Z, Ctrl+Y.
    document.addEventListener('keydown', function (e) {
      if (!(e.ctrlKey || e.metaKey)) return;
      var t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
      var k = e.key.toLowerCase();
      if (k === 'z' && !e.shiftKey) { e.preventDefault(); doUndo(); }
      else if ((k === 'z' && e.shiftKey) || k === 'y') { e.preventDefault(); doRedo(); }
    });
    aiGreetOnce();
  })();
  // Ajout de pièce : formulaire sur-mesure + fermeture de la modale
  (function () {
    var addBtn = document.getElementById('cfg-addroom-add');
    var addInput = document.getElementById('cfg-addroom-name');
    var addClose = document.getElementById('cfg-addroom-close');
    var addModal = document.getElementById('cfg-addroom');
    function submitCustom() {
      var input = document.getElementById('cfg-addroom-name');
      addCustomRoom(input ? input.value : '');
      closeAddRoom();
    }
    if (addBtn) addBtn.addEventListener('click', submitCustom);
    if (addInput) addInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); submitCustom(); }
    });
    if (addClose) addClose.addEventListener('click', closeAddRoom);
    if (addModal) addModal.addEventListener('click', function (e) {
      if (e.target === addModal) closeAddRoom();
    });
  })();
  document.getElementById('cfg-copy').addEventListener('click', function () {
    var input = document.getElementById('cfg-link');
    input.select();
    if (navigator.clipboard) navigator.clipboard.writeText(input.value);
    else document.execCommand('copy');
    var b = document.getElementById('cfg-copy');
    var t = b.textContent; b.textContent = 'Copié ✓';
    setTimeout(function () { b.textContent = t; }, 1500);
  });

  saveBtn.addEventListener('click', function () {
    if (!selectionItems().length) { errorEl.textContent = 'Ajoutez au moins un équipement avant de sauvegarder.'; return; }
    saveBtn.disabled = true;
    var label = saveBtn.textContent; saveBtn.textContent = 'Sauvegarde…';
    fetch(API + '/api/public/configurateur/sauvegarder', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: selectionItems(),
        installMode: radioValue('installMode', 'pro'),
        origin: window.location.origin,
      }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.code) throw new Error('no code');
        document.getElementById('cfg-qr').innerHTML = data.qr || '';
        document.getElementById('cfg-code').textContent = data.code;
        document.getElementById('cfg-link').value = data.url || '';
        modal.style.display = 'grid';
        if (window.plausible) window.plausible('Configurateur sauvegardé');
      })
      .catch(function () { errorEl.textContent = 'Sauvegarde impossible pour le moment. Réessayez.'; })
      .then(function () { saveBtn.disabled = false; saveBtn.textContent = label; });
  });

  // ── Reprise via ?code= ──
  function applyDraft(draft) {
    selection = {};
    (draft.items || []).forEach(function (it) {
      var room = it.room && ROOM_BY_KEY[it.room] ? it.room : 'maison';
      if (!selection[room]) selection[room] = {};
      selection[room][it.productId] = (selection[room][it.productId] || 0) + it.quantity;
    });
    if (draft.installMode) {
      var chip = document.querySelector('[data-radio="installMode"] .cfg-choice[data-value="' + draft.installMode + '"]');
      if (chip) { document.querySelectorAll('[data-radio="installMode"] .cfg-choice').forEach(function (c) { c.classList.remove('sel'); }); chip.classList.add('sel'); }
    }
    if (draft.estimate) { lastEstimate = draft.estimate; setTotal(draft.estimate.totalTTC || 0); }
    renderRecap();
    updateBridgeNote();
    show(2);
  }

  function loadFromCode(code) {
    fetch(API + '/api/public/configurateur/code/' + encodeURIComponent(code))
      .then(function (r) { if (!r.ok) throw new Error('not found'); return r.json(); })
      .then(applyDraft)
      .catch(function () { errorEl.textContent = 'Configuration introuvable pour ce code.'; });
  }

  var params = new URLSearchParams(window.location.search);
  var codeParam = params.get('code');

  loadCatalog();
  if (codeParam) loadFromCode(codeParam);
  else show(1);
})();
</script>

</body>
</html>
