# Server
PORT=3000
NODE_ENV=development
# Pilote l'affichage du centre de recette (active hors production)
APP_ENV=development

# Hotes (separes par des virgules) servant UNIQUEMENT l'API : sur ces domaines
# les interfaces HTML (/backoffice, /admin, /swagger) renvoient 404. Le back-office
# reste accessible via le domaine staff (reverse-proxy). Vide = aucun filtrage (dev).
# Ex prod : API_ONLY_HOSTS=api.neo-domotique.fr,stg.api.neo-domotique.fr
API_ONLY_HOSTS=

# Database
DATABASE_URL=postgres://neo:neo_secret@localhost:5432/neo_domotique

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=neo_minio
S3_SECRET_KEY=neo_minio_secret
S3_BUCKET_PHOTOS=neo-photos
S3_BUCKET_DOCUMENTS=neo-documents
S3_BUCKET_SCANS=neo-scans
S3_BUCKET_RECETTE=neo-recette
S3_REGION=us-east-1

# Recette (token pour l'export/resolution des retours via API)
RECETTE_EXPORT_TOKEN=change-me-recette-token

# Mattermost via compte bot (API REST) — notifie l'equipe :
#   - nouveau retour recette/feedback (canal dedie feedback)
#   - ouverture d'une conversation chatbot (canal commercial)
# Vide (URL ou token absent) = notifications desactivees (no-op).
# URL du serveur Mattermost (ex: https://mattermost.exemple.com).
MATTERMOST_URL=
# Token du compte bot (Setup Successful > Token). Secret : ne jamais commiter.
MATTERMOST_BOT_TOKEN=
# Equipe Mattermost (slug) pour resoudre un canal par son nom.
MATTERMOST_TEAM=
# Canal des retours (feedback/recette) : ID explicite (prioritaire) OU nom a resoudre.
MATTERMOST_FEEDBACK_CHANNEL_ID=
MATTERMOST_FEEDBACK_CHANNEL=feedback
# Canal des commerciaux : ID explicite (prioritaire) OU nom a resoudre.
MATTERMOST_COMMERCIAL_CHANNEL_ID=
MATTERMOST_COMMERCIAL_CHANNEL=commercial

# Admin
ADMIN_EMAIL=admin@neo.fr
ADMIN_PASSWORD=admin123

# OpenRouter (chatbot du site vitrine) — sans cle, le bot ne repond pas automatiquement
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Documenso (signature electronique)
DOCUMENSO_API_KEY=api_14g3cmhffs4hk6ry
DOCUMENSO_BASE_URL=https://app.documenso.com
